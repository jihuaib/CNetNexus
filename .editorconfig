# EditorConfig - https://editorconfig.org
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4

[*.{sh}]
indent_style = space
indent_size = 4

[*.{xml,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.cmake]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[Dockerfile]
indent_style = space
indent_size = 4
