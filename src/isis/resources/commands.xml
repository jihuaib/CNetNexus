<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="9">
    <views>
        <view view-name="isis">
            <template>&lt;NetNexus(config-isis-{ctx:8})&gt;</template>
        </view>
    </views>

    <show-this>
        <view name="isis"/>
        <view name="if"/>
        <view name="if-loop"/>
    </show-this>

    <command_groups>
        <!-- Group 1: isis <tag> / no isis [<tag>] -->
        <group group-id="1">
            <elements>
                <element id="1" cfg-id="1" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element id="2" type="keyword">
                    <name>isis</name>
                    <description>ISIS protocol</description>
                </element>
                <element id="3" cfg-id="2" type="parameter">
                    <name>&lt;tag&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>ISIS instance tag</description>
                </element>
                <element id="4" type="keyword">
                    <name>vrf</name>
                    <description>Bind the process to a VRF</description>
                </element>
                <element id="5" cfg-id="3" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <type>dynamic(4:1,string(1-63))</type>
                    <description>VRF name</description>
                </element>
            </elements>

            <commands>
                <command auto-start="true">
                    <expression>2 3</expression>
                    <views>config</views>
                    <to-view>isis</to-view>
                    <context-out>
                        <entry ctx-id="8" from-param="2"/>
                    </context-out>
                </command>
                <command auto-start="true">
                    <expression>2 3 4 5</expression>
                    <views>config</views>
                    <to-view>isis</to-view>
                    <context-out>
                        <entry ctx-id="8" from-param="2"/>
                    </context-out>
                </command>
                <command>
                    <expression>1 2</expression>
                    <views>config</views>
                </command>
                <command>
                    <expression>1 2 3</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

        <!-- Group 2: net <system-id> -->
        <group group-id="2">
            <elements>
                <element id="1" type="keyword">
                    <name>net</name>
                    <description>Set NET/System-ID string</description>
                </element>
                <element id="2" cfg-id="1" type="parameter">
                    <name>&lt;net&gt;</name>
                    <type>string(1-63)</type>
                    <description>NET/System-ID</description>
                </element>
                <element id="3" type="keyword">
                    <name>no</name>
                    <description>Remove NET/System-ID</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>isis</views>
                </command>
                <command>
                    <expression>3 1</expression>
                    <views>isis</views>
                </command>
            </commands>
        </group>

        <!-- Group 3: is-type -->
        <group group-id="3">
            <elements>
                <element id="1" type="keyword">
                    <name>is-type</name>
                    <description>Set ISIS level type</description>
                </element>
                <element id="2" cfg-id="1" type="keyword">
                    <name>level-1</name>
                    <description>Level-1 only</description>
                </element>
                <element id="3" cfg-id="2" type="keyword">
                    <name>level-2</name>
                    <description>Level-2 only</description>
                </element>
                <element id="4" cfg-id="3" type="keyword">
                    <name>level-1-2</name>
                    <description>Level-1-2</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>isis</views>
                    <inverse>is-type level-1-2</inverse>
                </command>
                <command>
                    <expression>1 3</expression>
                    <views>isis</views>
                    <inverse>is-type level-1-2</inverse>
                </command>
                <command>
                    <expression>1 4</expression>
                    <views>isis</views>
                </command>
            </commands>
        </group>

        <!-- Group 11: cost-style narrow|wide -->
        <group group-id="11">
            <elements>
                <element id="1" type="keyword">
                    <name>cost-style</name>
                    <description>Set ISIS metric cost style</description>
                </element>
                <element id="2" cfg-id="1" type="keyword">
                    <name>narrow</name>
                    <description>Narrow metric (RFC 1195, TLV 2/128, 6-bit)</description>
                </element>
                <element id="3" cfg-id="2" type="keyword">
                    <name>wide</name>
                    <description>Wide metric (RFC 5305/5308, TLV 22/135/236, 24/32-bit)</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>isis</views>
                </command>
                <command>
                    <expression>1 3</expression>
                    <views>isis</views>
                    <inverse>cost-style narrow</inverse>
                </command>
            </commands>
        </group>

        <!-- Group 4: [no] af ipv4|ipv6 -->
        <group group-id="4">
            <elements>
                <element id="1" cfg-id="1" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element id="2" type="keyword">
                    <name>af</name>
                    <description>Address family</description>
                </element>
                <element id="3" cfg-id="2" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 family</description>
                </element>
                <element id="4" cfg-id="3" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 family</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>2 3</expression>
                    <views>isis</views>
                </command>
                <command>
                    <expression>2 4</expression>
                    <views>isis</views>
                </command>
                <command>
                    <expression>1 2 3</expression>
                    <views>isis</views>
                </command>
                <command>
                    <expression>1 2 4</expression>
                    <views>isis</views>
                </command>
            </commands>
        </group>

        <!-- Group 5: interface-view ISIS commands (ipv4/ipv6 + tag) -->
        <group group-id="5">
            <elements>
                <element id="1" cfg-id="1" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element id="2" type="keyword">
                    <name>isis</name>
                    <description>ISIS protocol</description>
                </element>
                <element id="3" cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 ISIS interface commands</description>
                </element>
                <element id="4" cfg-id="3" type="keyword">
                    <name>enable</name>
                    <description>Enable ISIS on current interface</description>
                </element>
                <element id="5" cfg-id="4" type="keyword">
                    <name>metric</name>
                    <description>Set ISIS metric on current interface</description>
                </element>
                <element id="6" cfg-id="5" type="parameter">
                    <name>&lt;tag&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>ISIS instance tag</description>
                </element>
                <element id="7" cfg-id="6" type="parameter">
                    <name>&lt;metric&gt;</name>
                    <type>uint(1-16777215)</type>
                    <description>Wide metric</description>
                </element>
                <element id="8" cfg-id="7" type="keyword">
                    <name>hello-interval</name>
                    <description>Set ISIS hello interval</description>
                </element>
                <element id="9" cfg-id="8" type="parameter">
                    <name>&lt;hello-interval&gt;</name>
                    <type>uint(1-65535)</type>
                    <description>Hello interval in seconds</description>
                </element>
                <element id="10" cfg-id="9" type="keyword">
                    <name>hold-multiplier</name>
                    <description>Set ISIS hold multiplier</description>
                </element>
                <element id="11" cfg-id="10" type="parameter">
                    <name>&lt;hold-multiplier&gt;</name>
                    <type>uint(1-100)</type>
                    <description>Hold multiplier</description>
                </element>
                <element id="12" cfg-id="11" type="keyword">
                    <name>passive</name>
                    <description>Set ISIS passive mode on current interface</description>
                </element>
            </elements>

            <commands>
                <!-- enable -->
                <command>
                    <expression>2 4 6</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>2 3 4 6</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 4 6</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 3 4 6</expression>
                    <views>if,if-loop</views>
                </command>

                <!-- metric -->
                <command>
                    <expression>2 5 6 7</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>2 3 5 6 7</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 5 6</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 3 5 6</expression>
                    <views>if,if-loop</views>
                </command>

                <!-- hello-interval -->
                <command>
                    <expression>2 8 6 9</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>2 3 8 6 9</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 8 6</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 3 8 6</expression>
                    <views>if,if-loop</views>
                </command>

                <!-- hold-multiplier -->
                <command>
                    <expression>2 10 6 11</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>2 3 10 6 11</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 10 6</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 3 10 6</expression>
                    <views>if,if-loop</views>
                </command>

                <!-- passive -->
                <command>
                    <expression>2 12 6</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>2 3 12 6</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 12 6</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>1 2 3 12 6</expression>
                    <views>if,if-loop</views>
                </command>
            </commands>
        </group>

        <!-- Group 6: show isis summary ipv4|ipv6 <tag> -->
        <group group-id="6">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>isis</name>
                    <description>ISIS information</description>
                </element>
                <element id="3" type="keyword">
                    <name>summary</name>
                    <description>ISIS summary</description>
                </element>
                <element id="4" cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 view</description>
                </element>
                <element id="5" cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 view</description>
                </element>
                <element id="6" cfg-id="3" type="parameter">
                    <name>&lt;tag&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>ISIS instance tag filter</description>
                </element>
            </elements>

            <commands>
                <command><expression>1 2 3 4 6</expression><views>global</views></command>
                <command><expression>1 2 3 5 6</expression><views>global</views></command>
            </commands>
        </group>

        <!-- Group 7: show isis interface ipv4|ipv6 <tag> -->
        <group group-id="7">
            <elements>
                <element id="1" type="keyword"><name>show</name><description>Display system information</description></element>
                <element id="2" type="keyword"><name>isis</name><description>ISIS information</description></element>
                <element id="3" type="keyword"><name>interface</name><description>ISIS interface status</description></element>
                <element id="4" cfg-id="1" type="keyword"><name>ipv4</name><description>IPv4 view</description></element>
                <element id="5" cfg-id="2" type="keyword"><name>ipv6</name><description>IPv6 view</description></element>
                <element id="6" cfg-id="3" type="parameter">
                    <name>&lt;tag&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>ISIS instance tag filter</description>
                </element>
            </elements>

            <commands>
                <command><expression>1 2 3 4 6</expression><views>global</views></command>
                <command><expression>1 2 3 5 6</expression><views>global</views></command>
            </commands>
        </group>

        <!-- Group 8: show isis neighbor <tag> -->
        <group group-id="8">
            <elements>
                <element id="1" type="keyword"><name>show</name><description>Display system information</description></element>
                <element id="2" type="keyword"><name>isis</name><description>ISIS information</description></element>
                <element id="3" type="keyword"><name>neighbor</name><description>ISIS neighbors</description></element>
                <element id="4" cfg-id="3" type="parameter">
                    <name>&lt;tag&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>ISIS instance tag filter</description>
                </element>
                <element id="5" cfg-id="4" type="keyword">
                    <name>verbose</name>
                    <description>Show neighbor negotiation details</description>
                </element>
            </elements>

            <commands>
                <command><expression>1 2 3 4</expression><views>global</views></command>
                <command><expression>1 2 3 4 5</expression><views>global</views></command>
            </commands>
        </group>

        <!-- Group 9: show isis lsdb ipv4|ipv6 <tag> -->
        <group group-id="9">
            <elements>
                <element id="1" type="keyword"><name>show</name><description>Display system information</description></element>
                <element id="2" type="keyword"><name>isis</name><description>ISIS information</description></element>
                <element id="3" type="keyword"><name>lsdb</name><description>ISIS LSP database</description></element>
                <element id="4" cfg-id="1" type="keyword"><name>ipv4</name><description>IPv4 view</description></element>
                <element id="5" cfg-id="2" type="keyword"><name>ipv6</name><description>IPv6 view</description></element>
                <element id="6" cfg-id="3" type="parameter">
                    <name>&lt;tag&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>ISIS instance tag filter</description>
                </element>
            </elements>

            <commands>
                <command><expression>1 2 3 4 6</expression><views>global</views></command>
                <command><expression>1 2 3 5 6</expression><views>global</views></command>
            </commands>
        </group>

        <!-- Group 10: show isis route ipv4|ipv6 <tag> [<destination> <mask>] -->
        <group group-id="10">
            <elements>
                <element id="1" type="keyword"><name>show</name><description>Display system information</description></element>
                <element id="2" type="keyword"><name>isis</name><description>ISIS information</description></element>
                <element id="3" type="keyword"><name>route</name><description>ISIS learned routes</description></element>
                <element id="4" cfg-id="1" type="keyword"><name>ipv4</name><description>IPv4 view</description></element>
                <element id="5" cfg-id="2" type="keyword"><name>ipv6</name><description>IPv6 view</description></element>
                <element id="6" cfg-id="3" type="parameter">
                    <name>&lt;tag&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>ISIS instance tag</description>
                </element>
                <element id="7" cfg-id="4" type="parameter">
                    <name>&lt;destination&gt;</name>
                    <type>ipv4</type>
                    <description>IPv4 destination prefix</description>
                </element>
                <element id="8" cfg-id="5" type="parameter">
                    <name>&lt;mask&gt;</name>
                    <type>uint(0-32)</type>
                    <description>IPv4 prefix length</description>
                </element>
                <element id="9" cfg-id="6" type="parameter">
                    <name>&lt;destination6&gt;</name>
                    <type>ipv6</type>
                    <description>IPv6 destination prefix</description>
                </element>
                <element id="10" cfg-id="7" type="parameter">
                    <name>&lt;mask6&gt;</name>
                    <type>uint(0-128)</type>
                    <description>IPv6 prefix length</description>
                </element>
            </elements>

            <commands>
                <command><expression>1 2 3 4 6</expression><views>global</views></command>
                <command><expression>1 2 3 5 6</expression><views>global</views></command>
                <command><expression>1 2 3 4 6 7 8</expression><views>global</views></command>
                <command><expression>1 2 3 5 6 9 10</expression><views>global</views></command>
            </commands>
        </group>
    </command_groups>
</configuration>
