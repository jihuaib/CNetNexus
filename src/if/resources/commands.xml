<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="4">
    <views>
        <view view-id="5" view-name="if">
            <!-- {ctx:5} 由框架替换为 IF_CTX_VAR_IDX 值（1=GE-1, 2=GE-2, 3=GE-3, 4=GE-4） -->
            <template>&lt;NetNexus(config-if-GE-{ctx:5})&gt;</template>
        </view>
    </views>

    <command_groups>
        <!-- Interface Entry Command -->
        <group group-id="1">
            <elements>
                <element type="keyword">
                    <name>if</name> <!-- 1 -->
                    <description>Enter interface configuration mode</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>GE-1</name> <!-- 2 -->
                    <description>Interface name</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>GE-2</name> <!-- 3 -->
                    <description>Interface name</description>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>GE-3</name> <!-- 4 -->
                    <description>Interface name</description>
                </element>
                <element cfg-id="4" type="keyword">
                    <name>GE-4</name> <!-- 5 -->
                    <description>Interface name</description>
                </element>
            </elements>
            <commands>
                <!-- if GE-1: ctx-id=5(IF_CTX_VAR_IDX)=1 -->
                <command>
                    <expression>1 2</expression>
                    <views>3</views>
                    <view-id>5</view-id>
                    <context-out>
                        <entry ctx-id="5" value="1"/>
                    </context-out>
                </command>
                <!-- if GE-2: ctx-id=5=2 -->
                <command>
                    <expression>1 3</expression>
                    <views>3</views>
                    <view-id>5</view-id>
                    <context-out>
                        <entry ctx-id="5" value="2"/>
                    </context-out>
                </command>
                <!-- if GE-3: ctx-id=5=3 -->
                <command>
                    <expression>1 4</expression>
                    <views>3</views>
                    <view-id>5</view-id>
                    <context-out>
                        <entry ctx-id="5" value="3"/>
                    </context-out>
                </command>
                <!-- if GE-4: ctx-id=5=4 -->
                <command>
                    <expression>1 5</expression>
                    <views>3</views>
                    <view-id>5</view-id>
                    <context-out>
                        <entry ctx-id="5" value="4"/>
                    </context-out>
                </command>
            </commands>
        </group>

        <!-- Interface Configuration Commands -->
        <group group-id="2">
            <elements>
                <element type="keyword">
                    <name>ip</name> <!-- 1 -->
                    <description>IP configuration</description>
                </element>
                <element type="keyword">
                    <name>address</name> <!-- 2 -->
                    <description>Configure IP address</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;ip-address&gt;</name> <!-- 3 -->
                    <description>IPv4 address</description>
                    <type>ip</type>
                </element>
                <element cfg-id="2" type="parameter">
                    <name>&lt;prefix-len&gt;</name> <!-- 4 -->
                    <description>Prefix length (0-32)</description>
                    <type>integer(0-32)</type>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>shutdown</name> <!-- 5 -->
                    <description>Disable the interface</description>
                </element>
                <element cfg-id="4" type="keyword">
                    <name>no</name> <!-- 6 -->
                    <description>Negate a command</description>
                </element>
            </elements>
            <commands>
                <!-- ip address <ip> <prefix-len> -->
                <command>
                    <expression>1 2 3 4</expression>
                    <views>5</views>
                </command>
                <!-- shutdown -->
                <command>
                    <expression>5</expression>
                    <views>5</views>
                </command>
                <!-- no shutdown -->
                <command>
                    <expression>6 5</expression>
                    <views>5</views>
                </command>
            </commands>
        </group>

        <!-- Show Commands -->
        <group group-id="3">
            <elements>
                <element type="keyword">
                    <name>show</name> <!-- 1 -->
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>if</name> <!-- 2 -->
                    <description>Interface information</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>GE-1</name> <!-- 3 -->
                    <description>Interface name</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>GE-2</name> <!-- 4 -->
                    <description>Interface name</description>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>GE-3</name> <!-- 5 -->
                    <description>Interface name</description>
                </element>
                <element cfg-id="4" type="keyword">
                    <name>GE-4</name> <!-- 6 -->
                    <description>Interface name</description>
                </element>
            </elements>
            <commands>
                <!-- show if -->
                <command>
                    <expression>1 2</expression>
                    <views>1,2,3,5</views>
                </command>
                <!-- show if <name> -->
                <command>
                    <expression>1 2 { 3 | 4 | 5 | 6 }</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
