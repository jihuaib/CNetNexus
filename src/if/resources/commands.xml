<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="5">
    <views>
        <view view-name="if">
            <!-- {ctx:4} 由框架替换为 CLI_CTX_ID_IF_IDX 值（1=GE-1 ... 8=GE-8） -->
            <template>&lt;NetNexus(config-if-GE-{ctx:4})&gt;</template>
        </view>
        <view view-name="if-null0">
            <!-- {ctx:4} 由框架替换为 CLI_CTX_ID_IF_IDX 值（0=null0） -->
            <template>&lt;NetNexus(config-if-null0)&gt;</template>
        </view>
        <view view-name="if-loop">
            <!-- {ctx:6} 由框架替换为 CLI_CTX_ID_IF_LOOP_IDX 值（loop 接口编号） -->
            <template>&lt;NetNexus(config-if-loop{ctx:6})&gt;</template>
        </view>
    </views>

    <show-this>
        <view name="if"/>
        <view name="if-null0"/>
        <view name="if-loop"/>
    </show-this>

    <command_groups>
        <!-- Interface Entry Command -->
        <group group-id="1">
            <elements>
                <element id="1" type="keyword">
                    <name>if</name> <!-- 1 -->
                    <description>Enter interface configuration mode</description>
                </element>
                <element id="2" cfg-id="1" type="keyword">
                    <name>GE-1</name> <!-- 2 -->
                    <description>Interface name</description>
                </element>
                <element id="3" cfg-id="2" type="keyword">
                    <name>GE-2</name> <!-- 3 -->
                    <description>Interface name</description>
                </element>
                <element id="4" cfg-id="3" type="keyword">
                    <name>GE-3</name> <!-- 4 -->
                    <description>Interface name</description>
                </element>
                <element id="5" cfg-id="4" type="keyword">
                    <name>GE-4</name> <!-- 5 -->
                    <description>Interface name</description>
                </element>
                <element id="6" cfg-id="0" type="keyword">
                    <name>null0</name> <!-- 6 -->
                    <description>Null interface</description>
                </element>
                <element id="7" cfg-id="5" type="keyword">
                    <name>GE-5</name> <!-- 7 -->
                    <description>Interface name</description>
                </element>
                <element id="8" cfg-id="6" type="keyword">
                    <name>GE-6</name> <!-- 8 -->
                    <description>Interface name</description>
                </element>
                <element id="9" cfg-id="7" type="keyword">
                    <name>GE-7</name> <!-- 9 -->
                    <description>Interface name</description>
                </element>
                <element id="10" cfg-id="8" type="keyword">
                    <name>GE-8</name> <!-- 10 -->
                    <description>Interface name</description>
                </element>
            </elements>
            <commands>
                <!-- if GE-1: ctx-id=4(CLI_CTX_ID_IF_IDX)=1 -->
                <command>
                    <expression>1 2</expression>
                    <views>config</views>
                    <to-view>if</to-view>
                    <context-out>
                        <entry ctx-id="4" value="1"/>
                    </context-out>
                </command>
                <!-- if GE-2: ctx-id=4=2 -->
                <command>
                    <expression>1 3</expression>
                    <views>config</views>
                    <to-view>if</to-view>
                    <context-out>
                        <entry ctx-id="4" value="2"/>
                    </context-out>
                </command>
                <!-- if GE-3: ctx-id=4=3 -->
                <command>
                    <expression>1 4</expression>
                    <views>config</views>
                    <to-view>if</to-view>
                    <context-out>
                        <entry ctx-id="4" value="3"/>
                    </context-out>
                </command>
                <!-- if GE-4: ctx-id=4=4 -->
                <command>
                    <expression>1 5</expression>
                    <views>config</views>
                    <to-view>if</to-view>
                    <context-out>
                        <entry ctx-id="4" value="4"/>
                    </context-out>
                </command>
                <!-- if GE-5: ctx-id=4=5 -->
                <command>
                    <expression>1 7</expression>
                    <views>config</views>
                    <to-view>if</to-view>
                    <context-out>
                        <entry ctx-id="4" value="5"/>
                    </context-out>
                </command>
                <!-- if GE-6: ctx-id=4=6 -->
                <command>
                    <expression>1 8</expression>
                    <views>config</views>
                    <to-view>if</to-view>
                    <context-out>
                        <entry ctx-id="4" value="6"/>
                    </context-out>
                </command>
                <!-- if GE-7: ctx-id=4=7 -->
                <command>
                    <expression>1 9</expression>
                    <views>config</views>
                    <to-view>if</to-view>
                    <context-out>
                        <entry ctx-id="4" value="7"/>
                    </context-out>
                </command>
                <!-- if GE-8: ctx-id=4=8 -->
                <command>
                    <expression>1 10</expression>
                    <views>config</views>
                    <to-view>if</to-view>
                    <context-out>
                        <entry ctx-id="4" value="8"/>
                    </context-out>
                </command>
                <!-- if null0: ctx-id=4=0 -->
                <command>
                    <expression>1 6</expression>
                    <views>config</views>
                    <to-view>if-null0</to-view>
                    <context-out>
                        <entry ctx-id="4" value="0"/>
                    </context-out>
                </command>
            </commands>
        </group>

        <!-- Interface Configuration Commands -->
        <group group-id="2">
            <elements>
                <element id="1" type="keyword">
                    <name>ip</name> <!-- 1 -->
                    <description>IP configuration</description>
                </element>
                <element id="2" type="keyword">
                    <name>address</name> <!-- 2 -->
                    <description>Configure IP address</description>
                </element>
                <element id="3" cfg-id="1" type="parameter">
                    <name>&lt;ip-address&gt;</name> <!-- 3 -->
                    <description>IPv4 address</description>
                    <type>ipv4</type>
                </element>
                <element id="4" cfg-id="2" type="parameter">
                    <name>&lt;prefix-len&gt;</name> <!-- 4 -->
                    <description>Prefix length (0-32)</description>
                    <type>uint(0-32)</type>
                </element>
                <element id="5" cfg-id="3" type="keyword">
                    <name>shutdown</name> <!-- 5 -->
                    <description>Disable the interface</description>
                </element>
                <element id="6" cfg-id="4" type="keyword">
                    <name>no</name> <!-- 6 -->
                    <description>Negate a command</description>
                </element>
                <element id="7" cfg-id="5" type="keyword">
                    <name>ipv6</name> <!-- 7 -->
                    <description>IPv6 configuration</description>
                </element>
                <element id="8" cfg-id="6" type="parameter">
                    <name>&lt;ipv6-address&gt;</name> <!-- 8 -->
                    <description>IPv6 address</description>
                    <type>ipv6</type>
                </element>
                <element id="9" cfg-id="7" type="parameter">
                    <name>&lt;prefix-len&gt;</name> <!-- 9 -->
                    <description>IPv6 prefix length (0-128)</description>
                    <type>uint(0-128)</type>
                </element>
                <element id="10" cfg-id="8" type="keyword">
                    <name>vrf</name> <!-- 10 -->
                    <description>VRF binding</description>
                </element>
                <element id="11" cfg-id="9" type="keyword">
                    <name>forwarding</name> <!-- 11 -->
                    <description>Bind interface to VRF</description>
                </element>
                <element id="12" cfg-id="10" type="parameter">
                    <name>&lt;vrf-name&gt;</name> <!-- 12 -->
                    <description>VRF name</description>
                    <type>dynamic(4:1,string(1-63))</type>
                </element>
            </elements>
            <commands>
                <!-- ip address <ip> <prefix-len>：GE 和 loop 视图均可用 -->
                <command>
                    <expression>1 2 3 4</expression>
                    <views>if,if-loop</views>
                </command>
                <!-- no ip address <ip> <prefix-len>：GE 和 loop 视图均可用 -->
                <command>
                    <expression>6 1 2 3 4</expression>
                    <views>if,if-loop</views>
                </command>
                <!-- ipv6 address <ipv6> <prefix-len>：GE 和 loop 视图均可用 -->
                <command>
                    <expression>7 2 8 9</expression>
                    <views>if,if-loop</views>
                </command>
                <!-- no ipv6 address <ipv6> <prefix-len>：GE 和 loop 视图均可用 -->
                <command>
                    <expression>6 7 2 8 9</expression>
                    <views>if,if-loop</views>
                </command>
                <!-- shutdown / no shutdown：仅 GE 视图（loop 不支持） -->
                <command>
                    <expression>5</expression>
                    <views>if</views>
                </command>
                <command>
                    <expression>6 5</expression>
                    <views>if</views>
                </command>
                <!-- vrf forwarding <vrf-name> / no vrf forwarding：GE 和 loop 视图均可用，自动清空 IP -->
                <command>
                    <expression>10 11 12</expression>
                    <views>if,if-loop</views>
                </command>
                <command>
                    <expression>6 10 11</expression>
                    <views>if,if-loop</views>
                </command>
            </commands>
        </group>

        <!-- Show Commands -->
        <group group-id="3">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name> <!-- 1 -->
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>if</name> <!-- 2 -->
                    <description>Interface information</description>
                </element>
                <element id="3" cfg-id="1" type="keyword">
                    <name>GE-1</name> <!-- 3 -->
                    <description>Interface name</description>
                </element>
                <element id="4" cfg-id="2" type="keyword">
                    <name>GE-2</name> <!-- 4 -->
                    <description>Interface name</description>
                </element>
                <element id="5" cfg-id="3" type="keyword">
                    <name>GE-3</name> <!-- 5 -->
                    <description>Interface name</description>
                </element>
                <element id="6" cfg-id="4" type="keyword">
                    <name>GE-4</name> <!-- 6 -->
                    <description>Interface name</description>
                </element>
                <element id="7" type="keyword">
                    <name>loop</name> <!-- 7 -->
                    <description>Loopback interface</description>
                </element>
                <element id="8" cfg-id="9" type="parameter">
                    <name>&lt;loop-id&gt;</name> <!-- 8 -->
                    <description>Loopback interface number (1-1024)</description>
                    <type>uint(1-1024)</type>
                </element>
                <element id="9" cfg-id="5" type="keyword">
                    <name>GE-5</name> <!-- 9 -->
                    <description>Interface name</description>
                </element>
                <element id="10" cfg-id="6" type="keyword">
                    <name>GE-6</name> <!-- 10 -->
                    <description>Interface name</description>
                </element>
                <element id="11" cfg-id="7" type="keyword">
                    <name>GE-7</name> <!-- 11 -->
                    <description>Interface name</description>
                </element>
                <element id="12" cfg-id="8" type="keyword">
                    <name>GE-8</name> <!-- 12 -->
                    <description>Interface name</description>
                </element>
                <element id="13" cfg-id="10" type="keyword">
                    <name>subscribe</name> <!-- 13 -->
                    <description>IF event subscriptions</description>
                </element>
            </elements>
            <commands>
                <!-- show if -->
                <command>
                    <expression>1 2</expression>
                    <views>global</views>
                </command>
                <!-- show if <GE-x> -->
                <command>
                    <expression>1 2 { 3 | 4 | 5 | 6 | 9 | 10 | 11 | 12 }</expression>
                    <views>global</views>
                </command>
                <!-- show if loop <N> -->
                <command>
                    <expression>1 2 7 8</expression>
                    <views>global</views>
                </command>
                <!-- show if subscribe -->
                <command>
                    <expression>1 2 13</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- Loop Interface Entry / Delete Commands -->
        <group group-id="4">
            <elements>
                <element id="1" type="keyword">
                    <name>if</name> <!-- 1 -->
                    <description>接口配置</description>
                </element>
                <element id="2" type="keyword">
                    <name>loop</name> <!-- 2 -->
                    <description>Loopback 接口</description>
                </element>
                <element id="3" cfg-id="1" type="parameter">
                    <name>&lt;loop-id&gt;</name> <!-- 3 -->
                    <description>Loopback 接口编号（1-1024）</description>
                    <type>uint(1-1024)</type>
                </element>
                <element id="4" type="keyword">
                    <name>no</name> <!-- 4 -->
                    <description>删除命令</description>
                </element>
            </elements>
            <commands>
                <!-- if loop <N>：进入 if-loop 视图，ctx-id=6 取自参数 cfg-id=1 -->
                <command>
                    <expression>1 2 3</expression>
                    <views>config</views>
                    <to-view>if-loop</to-view>
                    <context-out>
                        <entry ctx-id="6" from-param="1"/>
                    </context-out>
                </command>
                <!-- no if loop <N>：删除 loop 接口，留在 config 视图 -->
                <command>
                    <expression>4 1 2 3</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

    </command_groups>
</configuration>
