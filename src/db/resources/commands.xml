<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="2">
    <views></views>

    <command_groups>
        <!-- show db list -->
        <group group-id="1" db="db_show_db" table="db_show_meta">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>db</name>
                    <description>Database information</description>
                </element>
                <element type="keyword">
                    <name>list</name>
                    <description>Database list information</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>1</views>
                    <show-template>db_show_list_template</show-template>
                </command>
            </commands>
        </group>

        <!-- show db <db-name> table-list -->
        <group group-id="2" db="db_show_db" table="db_show_tables">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>db</name>
                    <description>Database information</description>
                </element>
                <element type="parameter" field="db_name">
                    <name>&lt;db-name&gt;</name>
                    <description>Database name</description>
                    <type>string(1-63)</type>
                </element>
                <element type="keyword">
                    <name>table-list</name>
                    <description>Show table list</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3 4</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>

        <!-- show db <db-name> table-field <table-name> -->
        <group group-id="3" db="db_show_db" table="db_show_fields">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>db</name>
                    <description>Database information</description>
                </element>
                <element type="parameter" field="db_name">
                    <name>&lt;db-name&gt;</name>
                    <description>Database name</description>
                    <type>string(1-63)</type>
                </element>
                <element type="keyword">
                    <name>table-field</name>
                    <description>Show table field</description>
                </element>
                <element type="parameter" field="table_name">
                    <name>&lt;table-name&gt;</name>
                    <description>Table name</description>
                    <type>string(1-63)</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3 4 5</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>

        <!-- show db <db-name> table-data <table-name> -->
        <group group-id="4" db="db_show_db" table="db_show_data">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>db</name>
                    <description>Database information</description>
                </element>
                <element type="parameter" field="db_name">
                    <name>&lt;db-name&gt;</name>
                    <description>Database name</description>
                    <type>string(1-63)</type>
                </element>
                <element type="keyword">
                    <name>table-data</name>
                    <description>Show table data</description>
                </element>
                <element type="parameter" field="table_name">
                    <name>&lt;table-name&gt;</name>
                    <description>Table name</description>
                    <type>string(1-63)</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3 4 5</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>
    </command_groups>

    <config_templates>
        <!-- DB show list 模板（临时 DB） -->
        <template-def template-name="db_show_list_template" priority="0">
            <template-def template-name="db_show_row_template"/>
        </template-def>

        <template template-name="db_show_list_template" db="db_show_db.db_show_meta">
Registered Databases:
{% if db_show_meta.has_rows == 0 %}
No databases registered.
{% else %}
Name            Module     Tables
---------------- ---------- ------
{% endif %}
        </template>

        <template template-name="db_show_row_template" db="db_show_db.db_show_row">
{db_show_row.name:&lt;16} {db_show_row.module:&lt;10} {db_show_row.tables:&gt;6}
        </template>
    </config_templates>

    <dbs>
        <db db-name="db_show_db">
            <tables>
                <table table-name="db_show_meta">
                    <fields>
                        <field field-name="has_rows" type="uint(0-1)"/>
                        <field field-name="total" type="uint(0-65535)"/>
                    </fields>
                </table>
                <table table-name="db_show_row">
                    <fields>
                        <field field-name="name" type="string(1-63)"/>
                        <field field-name="module" type="string(1-63)"/>
                        <field field-name="tables" type="uint(0-65535)"/>
                    </fields>
                </table>
            </tables>
        </db>
    </dbs>
</configuration>
