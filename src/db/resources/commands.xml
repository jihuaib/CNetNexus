<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="2">
    <views></views>
    <command_groups>
        <!-- DB Show Commands -->
        <group group-id="1">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name> <!-- 1 -->
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>db</name> <!-- 2 -->
                    <description>Database information</description>
                </element>
                <element id="3" cfg-id="1" type="keyword">
                    <name>table-list</name> <!-- 3 -->
                    <description>Show all tables in the database</description>
                </element>
                <element id="4" cfg-id="2" type="keyword">
                    <name>table-field</name> <!-- 4 -->
                    <description>Show fields of a table</description>
                </element>
                <element id="5" cfg-id="3" type="keyword">
                    <name>table-data</name> <!-- 5 -->
                    <description>Show data in a table</description>
                </element>
                <element id="6" cfg-id="4" type="parameter">
                    <name>&lt;table-name&gt;</name> <!-- 6 -->
                    <description>Table name</description>
                    <!-- dynamic：Tab/? 时 RPC 查询 DB 模块返回当前所有已创建的表名 -->
                    <type>dynamic(string(1-63))</type>
                </element>
            </elements>

            <commands>
                <!-- show db table-list -->
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
                <!-- show db table-field <table-name> -->
                <command>
                    <expression>1 2 4 6</expression>
                    <views>global</views>
                </command>
                <!-- show db table-data <table-name> -->
                <command>
                    <expression>1 2 5 6</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- 配置管理：save / startup / show configuration -->
        <group group-id="2">
            <elements>
                <element id="1" cfg-id="1" type="keyword">
                    <name>save</name>
                    <description>Save the running configuration to a named startup snapshot</description>
                </element>
                <element id="2" cfg-id="2" type="keyword">
                    <name>startup</name>
                    <description>Select which saved configuration to restore on next boot</description>
                </element>
                <element id="3" cfg-id="3" type="keyword">
                    <name>show</name>
                    <description>Display information</description>
                </element>
                <element id="4" type="keyword">
                    <name>configuration</name>
                    <description>Configuration snapshot</description>
                </element>
                <element id="5" cfg-id="4" type="parameter">
                    <name>&lt;name&gt;</name>
                    <description>Configuration name (A-Z a-z 0-9 _ - , max 63)</description>
                    <type>string(1-63)</type>
                </element>
                <element id="6" cfg-id="5" type="keyword">
                    <name>db</name>
                    <description>Restore the saved SQLite database snapshot on next boot</description>
                </element>
                <element id="7" cfg-id="6" type="keyword">
                    <name>cfg</name>
                    <description>Replay the saved BDR configuration text on next boot</description>
                </element>
                <element id="8" cfg-id="7" type="keyword">
                    <name>replay-failures</name>
                    <description>Display startup cfg replay failures</description>
                </element>
            </elements>

            <commands>
                <!-- save configuration -->
                <command>
                    <expression>1 4</expression>
                    <views>global</views>
                </command>
                <!-- save configuration <name> -->
                <command>
                    <expression>1 4 5</expression>
                    <views>global</views>
                </command>
                <!-- startup configuration <name> db -->
                <command>
                    <expression>2 4 5 6</expression>
                    <views>global</views>
                </command>
                <!-- startup configuration <name> cfg -->
                <command>
                    <expression>2 4 5 7</expression>
                    <views>global</views>
                </command>
                <!-- show startup configuration -->
                <command>
                    <expression>3 2 4</expression>
                    <views>global</views>
                </command>
                <!-- show configuration replay-failures -->
                <command>
                    <expression>3 4 8</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
