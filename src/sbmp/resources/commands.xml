                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv6-unicast</name>
                    <description>IPv6 unicast routes</description>
                </element>
                <element type="keyword">
                    <name>client</name>
                    <description>Filter by BMP client</description>
                </element>
                <element cfg-id="3" type="parameter">
                    <name>&lt;client-id&gt;</name>
                    <type>string</type>
                    <description>BMP client ID (source IP)</description>
                </element>
                <element type="keyword">
