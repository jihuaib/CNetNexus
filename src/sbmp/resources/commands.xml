                </element>
                <element cfg-id="5" type="keyword">
                    <name>pre</name>
                    <description>Pre-policy (Adj-RIB-In)</description>
                </element>
                <element cfg-id="6" type="keyword">
                    <name>post</name>
                    <description>Post-policy routes</description>
                </element>
                <element cfg-id="7" type="keyword">
                    <name>loc-rib</name>
                    <description>Loc-RIB routes</description>
                </element>
            </elements>

            <commands>
