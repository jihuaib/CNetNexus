<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="1">
    <!-- Command group definitions -->
    <command_groups>
        <!-- show version -->
        <group group-id="1">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>version</name>
                    <description>Version information</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>

        <!-- show dev modules -->
        <group group-id="3">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>dev</name>
                    <description>Device and module management</description>
                </element>
                <element type="keyword">
                    <name>modules</name>
                    <description>Show registered modules</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>1,3</views>
                </command>
            </commands>
        </group>

        <!-- sysname (placeholder) -->
        <group group-id="2">
            <elements>
                <element type="keyword">
                    <name>sysname</name>
                    <description>Set system hostname</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;hostname&gt;</name>
                    <description>System hostname</description>
                    <type>string(1-63)</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>3</views>
                </command>
            </commands>
        </group>

        <!-- dev log-level <level> -->
        <group group-id="4">
            <elements>
                <element type="keyword">
                    <name>dev</name>
                    <description>Device and module management</description>
                </element>
                <element type="keyword">
                    <name>log-level</name>
                    <description>Set runtime log level</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;level&gt;</name>
                    <description>debug/info/warn/error</description>
                    <type>string(4-5)</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>3</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
