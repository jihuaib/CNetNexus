<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="1">
    <!-- Command group definitions -->
    <command_groups>
        <!-- show version -->
        <group group-id="1">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>version</name>
                    <description>Version information</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show dev modules -->
        <group group-id="3">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>dev</name>
                    <description>Device and module management</description>
                </element>
                <element id="3" type="keyword">
                    <name>modules</name>
                    <description>Show registered modules</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- sysname <hostname> / no sysname -->
        <group group-id="2">
            <elements>
                <element id="1" type="keyword">
                    <name>sysname</name>
                    <description>Set system hostname</description>
                </element>
                <element id="2" cfg-id="1" type="parameter">
                    <name>&lt;hostname&gt;</name>
                    <description>System hostname</description>
                    <type>string(1-63)</type>
                </element>
                <element id="3" type="keyword">
                    <name>no</name>
                    <description>Restore default hostname</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>config</views>
                </command>
                <command>
                    <expression>3 1</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

        <!-- ping <ipv4-address> [-a <src-ipv4>] [vrf <vrf-name>] / ping ipv6 <ipv6-address> [-a <src-ipv6>] [vrf <vrf-name>] / ping mpls ipv4 <prefix/len> [-a <src-ipv4>] -->
        <group group-id="5">
            <elements>
                <element id="1" type="keyword">
                    <name>ping</name>
                    <description>Ping a remote host</description>
                </element>
                <element id="2" cfg-id="1" type="parameter">
                    <name>&lt;ipv4-address&gt;</name>
                    <description>Target IPv4 address</description>
                    <type>ipv4</type>
                </element>
                <element id="3" cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>Use IPv6 ping</description>
                </element>
                <element id="4" cfg-id="3" type="parameter">
                    <name>&lt;ipv6-address&gt;</name>
                    <description>Target IPv6 address</description>
                    <type>ipv6</type>
                </element>
                <element id="5" type="keyword">
                    <name>-a</name>
                    <description>Specify source address</description>
                </element>
                <element id="6" cfg-id="4" type="parameter">
                    <name>&lt;src-ipv4&gt;</name>
                    <description>Source IPv4 address</description>
                    <type>ipv4</type>
                </element>
                <element id="7" cfg-id="5" type="parameter">
                    <name>&lt;src-ipv6&gt;</name>
                    <description>Source IPv6 address</description>
                    <type>ipv6</type>
                </element>
                <element id="8" cfg-id="6" type="keyword">
                    <name>mpls</name>
                    <description>Use MPLS tunnel forwarding</description>
                </element>
                <element id="9" cfg-id="7" type="keyword">
                    <name>ipv4</name>
                    <description>Use IPv4 MPLS FEC</description>
                </element>
                <element id="10" cfg-id="8" type="parameter">
                    <name>&lt;ipv4-prefix&gt;</name>
                    <description>Target IPv4 FEC prefix, for example 3.3.3.3/32</description>
                    <type>string(1-63)</type>
                </element>
                <element id="11" type="keyword">
                    <name>vrf</name>
                    <description>Use VRF routing table</description>
                </element>
                <element id="12" cfg-id="9" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <description>VRF name</description>
                    <type>dynamic(4:1,string(1-63))</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 [11 12]</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 2 5 6 [11 12]</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 3 4 [11 12]</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 3 4 5 7 [11 12]</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 8 9 10</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 8 9 10 5 6</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show dev ipc <module-name> -->
        <group group-id="6">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>dev</name>
                    <description>Device and module management</description>
                </element>
                <element id="3" type="keyword">
                    <name>ipc</name>
                    <description>IPC connection information</description>
                </element>
                <element id="4" cfg-id="1" type="parameter">
                    <name>&lt;module-name&gt;</name>
                    <description>Module name</description>
                    <type>dynamic(string(1-12))</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3 4</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- dev log log-level {debug|info|warn|error} -->
        <group group-id="4">
            <elements>
                <element id="1" type="keyword">
                    <name>dev</name>
                    <description>Device and module management</description>
                </element>
                <element id="2" type="keyword">
                    <name>log</name>
                    <description>Log subsystem configuration</description>
                </element>
                <element id="3" type="keyword">
                    <name>log-level</name>
                    <description>Set runtime log level</description>
                </element>
                <element id="4" cfg-id="1" type="keyword">
                    <name>debug</name>
                    <description>Debug level (verbose)</description>
                </element>
                <element id="5" cfg-id="2" type="keyword">
                    <name>info</name>
                    <description>Info level</description>
                </element>
                <element id="6" cfg-id="3" type="keyword">
                    <name>warn</name>
                    <description>Warning level</description>
                </element>
                <element id="7" cfg-id="4" type="keyword">
                    <name>error</name>
                    <description>Error level (least verbose)</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3 4</expression>
                    <views>config</views>
                </command>
                <command>
                    <expression>1 2 3 5</expression>
                    <views>config</views>
                </command>
                <command>
                    <expression>1 2 3 6</expression>
                    <views>config</views>
                </command>
                <command>
                    <expression>1 2 3 7</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

        <!-- reboot -->
        <group group-id="7">
            <elements>
                <element id="1" type="keyword">
                    <name>reboot</name>
                    <description>Reboot NetNexus software stack</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- process { reboot | start | stop } <module-name> -->
        <group group-id="9">
            <elements>
                <element id="1" type="keyword">
                    <name>process</name>
                    <description>Module process lifecycle control</description>
                </element>
                <element id="2" cfg-id="1" type="keyword">
                    <name>reboot</name>
                    <description>Restart a module process (SIGTERM + respawn, DB config preserved)</description>
                </element>
                <element id="3" cfg-id="2" type="keyword">
                    <name>start</name>
                    <description>Start a stopped module process (spawn if not running)</description>
                </element>
                <element id="4" cfg-id="3" type="keyword">
                    <name>stop</name>
                    <description>Stop a running module process (graceful shutdown, no respawn)</description>
                </element>
                <element id="5" cfg-id="4" type="parameter">
                    <name>&lt;module-name&gt;</name>
                    <description>Target module name (e.g. if, sbmp, bgp)</description>
                    <type>string(1-12)</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 5</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 3 5</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 4 5</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- dev swap-image <image-name> -->
        <group group-id="8">
            <elements>
                <element id="1" type="keyword">
                    <name>dev</name>
                    <description>Device and module management</description>
                </element>
                <element id="2" type="keyword">
                    <name>swap-image</name>
                    <description>Replace bin/lib from a pre-built image and reboot</description>
                </element>
                <element id="3" cfg-id="1" type="parameter">
                    <name>&lt;image-name&gt;</name>
                    <description>Target image name (e.g. netnexus:1.1.0)</description>
                    <type>string(1-128)</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
