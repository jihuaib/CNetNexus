<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="3">
    <!-- Command group definitions -->
    <command_groups>
        <!-- show cli command-info -->
        <group group-id="1">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element type="keyword">
                    <name>command-info</name>
                    <description>Command info</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>

        <!-- show cli history -->
        <group group-id="2">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element type="keyword">
                    <name>history</name>
                    <description>Command history</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>

        <!-- show current-configuration -->
        <group group-id="3">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>current-configuration</name>
                    <description>Display current configuration</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>

        <!-- exit -->
        <group group-id="4">
            <elements>
                <element type="keyword">
                    <name>exit</name>
                    <description>Exit current mode</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>

        <!-- config -->
        <group group-id="5">
            <elements>
                <element type="keyword">
                    <name>config</name>
                    <description>Enter configuration mode</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>2</views>
                </command>
            </commands>
        </group>

        <!-- end -->
        <group group-id="6">
            <elements>
                <element type="keyword">
                    <name>end</name>
                    <description>Return to user view</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
