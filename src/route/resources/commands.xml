<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="6">
    <!-- 视图定义 -->
    <views>
    </views>

    <!-- 命令组定义 -->
    <command_groups>

        <!-- ================================================================
             Group 1: 静态路由配置
             cfg-id: 1=no, 2=ipv4, 3=ipv6, 4=prefix(dest),
                     5=prefix_len(IPv4), 6=prefix_len(IPv6), 7=nexthop, 8=metric_value
             ================================================================ -->
        <group group-id="1">
            <elements>
                <element cfg-id="1" type="keyword">
                    <name>no</name>
                    <description>Delete route</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>Static route configuration</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 route</description>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 route</description>
                </element>
                <element cfg-id="4" type="parameter">
                    <name>&lt;prefix&gt;</name>
                    <type>string</type>
                    <description>Destination network address</description>
                </element>
                <element cfg-id="5" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(1-32)</type>
                    <description>Prefix length (IPv4, 1-32)</description>
                </element>
                <element cfg-id="6" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(1-128)</type>
                    <description>Prefix length (IPv6, 1-128)</description>
                </element>
                <element cfg-id="7" type="parameter">
                    <name>&lt;nexthop&gt;</name>
                    <type>string</type>
                    <description>Next-hop address</description>
                </element>
                <element type="keyword">
                    <name>metric</name>
                    <description>Set metric value</description>
                </element>
                <element cfg-id="8" type="parameter">
                    <name>&lt;metric-value&gt;</name>
                    <type>uint(0-255)</type>
                    <description>Route metric value (0-255)</description>
                </element>
                <element cfg-id="9" type="keyword">
                    <name>interface</name>
                    <description>Specify output interface</description>
                </element>
                <element cfg-id="10" type="parameter">
                    <name>&lt;ifname&gt;</name>
                    <type>dynamic(4:1,string(1-31))</type>
                    <description>Output interface name</description>
                </element>
            </elements>

            <commands>
                <!-- route ipv4 <prefix> <prefix-length> <nexthop> -->
                <command>
                    <expression>2 3 5 6 8</expression>
                    <views>config</views>
                </command>
                <!-- route ipv4 <prefix> <prefix-length> <nexthop> metric <value> -->
                <command>
                    <expression>2 3 5 6 8 9 10</expression>
                    <views>config</views>
                </command>
                <!-- no route ipv4 <prefix> <prefix-length> -->
                <command>
                    <expression>1 2 3 5 6</expression>
                    <views>config</views>
                </command>
                <!-- no route ipv4 <prefix> <prefix-length> <nexthop> -->
                <command>
                    <expression>1 2 3 5 6 8</expression>
                    <views>config</views>
                </command>
                <!-- route ipv6 <prefix> <prefix-length> <nexthop> -->
                <command>
                    <expression>2 4 5 7 8</expression>
                    <views>config</views>
                </command>
                <!-- route ipv6 <prefix> <prefix-length> <nexthop> metric <value> -->
                <command>
                    <expression>2 4 5 7 8 9 10</expression>
                    <views>config</views>
                </command>
                <!-- no route ipv6 <prefix> <prefix-length> -->
                <command>
                    <expression>1 2 4 5 7</expression>
                    <views>config</views>
                </command>
                <!-- no route ipv6 <prefix> <prefix-length> <nexthop> -->
                <command>
                    <expression>1 2 4 5 7 8</expression>
                    <views>config</views>
                </command>

                <!-- ===== nexthop + interface（IPv4）===== -->
                <!-- route ipv4 <prefix> <pfxlen> <nexthop> interface <ifname> -->
                <command>
                    <expression>2 3 5 6 8 11 12</expression>
                    <views>config</views>
                </command>
                <!-- route ipv4 <prefix> <pfxlen> <nexthop> interface <ifname> metric <value> -->
                <command>
                    <expression>2 3 5 6 8 11 12 9 10</expression>
                    <views>config</views>
                </command>
                <!-- no route ipv4 <prefix> <pfxlen> <nexthop> interface <ifname> -->
                <command>
                    <expression>1 2 3 5 6 8 11 12</expression>
                    <views>config</views>
                </command>

                <!-- ===== interface-only（IPv4）===== -->
                <!-- route ipv4 <prefix> <pfxlen> interface <ifname> -->
                <command>
                    <expression>2 3 5 6 11 12</expression>
                    <views>config</views>
                </command>
                <!-- route ipv4 <prefix> <pfxlen> interface <ifname> metric <value> -->
                <command>
                    <expression>2 3 5 6 11 12 9 10</expression>
                    <views>config</views>
                </command>
                <!-- no route ipv4 <prefix> <pfxlen> interface <ifname> -->
                <command>
                    <expression>1 2 3 5 6 11 12</expression>
                    <views>config</views>
                </command>

                <!-- ===== nexthop + interface（IPv6）===== -->
                <!-- route ipv6 <prefix> <pfxlen> <nexthop> interface <ifname> -->
                <command>
                    <expression>2 4 5 7 8 11 12</expression>
                    <views>config</views>
                </command>
                <!-- route ipv6 <prefix> <pfxlen> <nexthop> interface <ifname> metric <value> -->
                <command>
                    <expression>2 4 5 7 8 11 12 9 10</expression>
                    <views>config</views>
                </command>
                <!-- no route ipv6 <prefix> <pfxlen> <nexthop> interface <ifname> -->
                <command>
                    <expression>1 2 4 5 7 8 11 12</expression>
                    <views>config</views>
                </command>

                <!-- ===== interface-only（IPv6）===== -->
                <!-- route ipv6 <prefix> <pfxlen> interface <ifname> -->
                <command>
                    <expression>2 4 5 7 11 12</expression>
                    <views>config</views>
                </command>
                <!-- route ipv6 <prefix> <pfxlen> interface <ifname> metric <value> -->
                <command>
                    <expression>2 4 5 7 11 12 9 10</expression>
                    <views>config</views>
                </command>
                <!-- no route ipv6 <prefix> <pfxlen> interface <ifname> -->
                <command>
                    <expression>1 2 4 5 7 11 12</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

        <!-- ================================================================
             Group 2: show route 命令
             元素位置：1=show, 2=route, 3=ipv4, 4=ipv6, 5=<destination>,
                       6=proto, 7=static, 8=bgp, 9=ospf, 10=summary,
                       11=connected, 12=os, 13=isis,
                       14=<prefix-length-v4>, 15=<prefix-length-v6>
             cfg-id: 1=ipv4, 2=ipv6, 4=dest_filter,
                     5=proto:static, 6=proto:bgp, 7=proto:ospf, 8=summary,
                     9=proto:connected, 10=os, 11=proto:isis,
                     12=dest_prefix_len_v4, 13=dest_prefix_len_v6
             ================================================================ -->
        <group group-id="2">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>Routing table</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 routes</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 routes</description>
                </element>
                <element cfg-id="4" type="parameter">
                    <name>&lt;destination&gt;</name>
                    <type>string</type>
                    <description>Filter by destination address</description>
                </element>
                <element type="keyword">
                    <name>proto</name>
                    <description>Filter by protocol type</description>
                </element>
                <element cfg-id="5" type="keyword">
                    <name>static</name>
                    <description>Static routes</description>
                </element>
                <element cfg-id="6" type="keyword">
                    <name>bgp</name>
                    <description>BGP routes</description>
                </element>
                <element cfg-id="7" type="keyword">
                    <name>ospf</name>
                    <description>OSPF routes</description>
                </element>
                <element cfg-id="8" type="keyword">
                    <name>summary</name>
                    <description>Route summary statistics</description>
                </element>
                <element cfg-id="9" type="keyword">
                    <name>connected</name>
                    <description>Directly connected routes</description>
                </element>
                <element cfg-id="10" type="keyword">
                    <name>os</name>
                    <description>Linux kernel routing table (all tables)</description>
                </element>
                <element cfg-id="11" type="keyword">
                    <name>isis</name>
                    <description>ISIS routes</description>
                </element>
                <element cfg-id="12" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-32)</type>
                    <description>IPv4 destination prefix length (0-32)</description>
                </element>
                <element cfg-id="13" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-128)</type>
                    <description>IPv6 destination prefix length (0-128)</description>
                </element>
            </elements>

            <commands>
                <!-- show route ipv4 -->
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 -->
                <command>
                    <expression>1 2 4</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 <destination> <prefix-length> -->
                <command>
                    <expression>1 2 3 5 14</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 <destination> <prefix-length> -->
                <command>
                    <expression>1 2 4 5 15</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto static -->
                <command>
                    <expression>1 2 3 6 7</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto static -->
                <command>
                    <expression>1 2 4 6 7</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto bgp -->
                <command>
                    <expression>1 2 3 6 8</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto bgp -->
                <command>
                    <expression>1 2 4 6 8</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto ospf -->
                <command>
                    <expression>1 2 3 6 9</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto ospf -->
                <command>
                    <expression>1 2 4 6 9</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto connected -->
                <command>
                    <expression>1 2 3 6 11</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto connected -->
                <command>
                    <expression>1 2 4 6 11</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto isis -->
                <command>
                    <expression>1 2 3 6 13</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto isis -->
                <command>
                    <expression>1 2 4 6 13</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 summary -->
                <command>
                    <expression>1 2 3 10</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 summary -->
                <command>
                    <expression>1 2 4 10</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 os -->
                <command>
                    <expression>1 2 3 12</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 os -->
                <command>
                    <expression>1 2 4 12</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- ================================================================
             Group 3: 批量路由命令
             cfg-id: 1=no, 2=batch, 3=ipv4, 4=ipv6,
                     5=start_addr, 6=prefix_len(IPv4,0-32), 7=prefix_len(IPv6,0-128),
                     8=count_value, 9=nexthop_value, 10=name
             元素顺序：no route batch <name> ipv4 ipv6 <start> <pfx4> <pfx6> count <count> nexthop <nexthop>
             ================================================================ -->
        <group group-id="3">
            <elements>
                <element cfg-id="1" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>Route</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>batch</name>
                    <description>Batch route operation</description>
                </element>
                <element cfg-id="10" type="parameter">
                    <name>&lt;name&gt;</name>
                    <type>string(1-63)</type>
                    <description>Batch name (used as key)</description>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 batch route</description>
                </element>
                <element cfg-id="4" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 batch route</description>
                </element>
                <element cfg-id="5" type="parameter">
                    <name>&lt;start-address&gt;</name>
                    <type>string</type>
                    <description>Starting network address</description>
                </element>
                <element cfg-id="6" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-32)</type>
                    <description>Prefix length (IPv4, 0-32)</description>
                </element>
                <element cfg-id="7" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-128)</type>
                    <description>Prefix length (IPv6, 0-128)</description>
                </element>
                <element type="keyword">
                    <name>count</name>
                    <description>Route count</description>
                </element>
                <element cfg-id="8" type="parameter">
                    <name>&lt;count&gt;</name>
                    <type>uint(1-100000)</type>
                    <description>Number of routes to generate</description>
                </element>
                <element type="keyword">
                    <name>nexthop</name>
                    <description>Next-hop</description>
                </element>
                <element cfg-id="9" type="parameter">
                    <name>&lt;nexthop&gt;</name>
                    <type>string</type>
                    <description>Next-hop address</description>
                </element>
            </elements>

            <commands>
                <!-- route batch <name> ipv4 <start> <pfx4> count <N> nexthop <nh> -->
                <command>
                    <expression>2 3 4 5 7 8 10 11 12 13</expression>
                    <views>config</views>
                </command>
                <!-- route batch <name> ipv6 <start> <pfx6> count <N> nexthop <nh> -->
                <command>
                    <expression>2 3 4 6 7 9 10 11 12 13</expression>
                    <views>config</views>
                </command>
                <!-- no route batch <name> -->
                <command>
                    <expression>1 2 3 4</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

        <!-- ================================================================
             Group 5: show route ipv4/ipv6 static 命令（候选静态路由表）
             cfg-id: 1=ipv4, 2=ipv6
             ================================================================ -->
        <group group-id="5">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>Route module</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 static candidate table</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 static candidate table</description>
                </element>
                <element type="keyword">
                    <name>static</name>
                    <description>Static route candidate table</description>
                </element>
            </elements>

            <commands>
                <!-- show route ipv4 static -->
                <command>
                    <expression>1 2 3 5</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 static -->
                <command>
                    <expression>1 2 4 5</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- ================================================================
             Group 4: show route ipv4/ipv6 relay 命令
             cfg-id: 1=ipv4, 2=ipv6, 3=bgp（按 BGP 模块过滤），4=static（按静态路由过滤）
             ================================================================ -->
        <group group-id="4">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>Route module</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 relay watch table</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 relay watch table</description>
                </element>
                <element type="keyword">
                    <name>relay</name>
                    <description>Nexthop iteration relay watch table</description>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>bgp</name>
                    <description>Filter by BGP module</description>
                </element>
                <element cfg-id="4" type="keyword">
                    <name>static</name>
                    <description>Show static route nexthop relay status (candidate table)</description>
                </element>
            </elements>

            <commands>
                <!-- show route ipv4 relay -->
                <command>
                    <expression>1 2 3 5</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 relay -->
                <command>
                    <expression>1 2 4 5</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 relay bgp -->
                <command>
                    <expression>1 2 3 5 6</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 relay bgp -->
                <command>
                    <expression>1 2 4 5 6</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 relay static -->
                <command>
                    <expression>1 2 3 5 7</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 relay static -->
                <command>
                    <expression>1 2 4 5 7</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

    </command_groups>
</configuration>
