<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="7">
    <!-- 视图定义 -->
    <views>
    </views>

    <!-- 命令组定义 -->
    <command_groups>

        <!-- ================================================================
             Group 1: 静态路由配置
             cfg-id: 1=no, 2=ipv4, 3=ipv6, 4=prefix(dest),
                     5=prefix_len(IPv4), 6=prefix_len(IPv6), 7=nexthop, 8=metric_value,
                     9=interface, 10=ifname, 11=vrf, 12=vrf-name
             ================================================================ -->
        <group group-id="1">
            <elements>
                <element id="1" cfg-id="1" type="keyword">
                    <name>no</name>
                    <description>Delete route</description>
                </element>
                <element id="2" type="keyword">
                    <name>route</name>
                    <description>Routing configuration</description>
                </element>
                <element id="3" type="keyword">
                    <name>static</name>
                    <description>Static route configuration</description>
                </element>
                <element id="4" cfg-id="2" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 route</description>
                </element>
                <element id="5" cfg-id="3" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 route</description>
                </element>
                <element id="6" cfg-id="4" type="parameter">
                    <name>&lt;prefix&gt;</name>
                    <type>string</type>
                    <description>Destination network address</description>
                </element>
                <element id="7" cfg-id="5" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(1-32)</type>
                    <description>Prefix length (IPv4, 1-32)</description>
                </element>
                <element id="8" cfg-id="6" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(1-128)</type>
                    <description>Prefix length (IPv6, 1-128)</description>
                </element>
                <element id="9" cfg-id="7" type="parameter">
                    <name>&lt;nexthop&gt;</name>
                    <type>string</type>
                    <description>Next-hop address</description>
                </element>
                <element id="10" type="keyword">
                    <name>metric</name>
                    <description>Set metric value</description>
                </element>
                <element id="11" cfg-id="8" type="parameter">
                    <name>&lt;metric-value&gt;</name>
                    <type>uint(0-255)</type>
                    <description>Route metric value (0-255)</description>
                </element>
                <element id="12" cfg-id="9" type="keyword">
                    <name>interface</name>
                    <description>Specify output interface</description>
                </element>
                <element id="13" cfg-id="10" type="parameter">
                    <name>&lt;ifname&gt;</name>
                    <type>dynamic(5:1,string(1-31))</type>
                    <description>Output interface name</description>
                </element>
                <element id="14" cfg-id="11" type="keyword">
                    <name>vrf</name>
                    <description>Route VRF</description>
                </element>
                <element id="15" cfg-id="12" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <type>dynamic(4:1,string(1-63))</type>
                    <description>VRF name</description>
                </element>
            </elements>

            <commands>
                <!-- route static ipv4 <prefix> <prefix-length> <nexthop> -->
                <command>
                    <expression>2 3 4 [14 15] 6 7 9</expression>
                    <views>config</views>
                </command>
                <!-- route static ipv4 <prefix> <prefix-length> <nexthop> metric <value> -->
                <command>
                    <expression>2 3 4 [14 15] 6 7 9 10 11</expression>
                    <views>config</views>
                </command>
                <!-- no route static ipv4 <prefix> <prefix-length> -->
                <command>
                    <expression>1 2 3 4 [14 15] 6 7</expression>
                    <views>config</views>
                </command>
                <!-- no route static ipv4 <prefix> <prefix-length> <nexthop> -->
                <command>
                    <expression>1 2 3 4 [14 15] 6 7 9</expression>
                    <views>config</views>
                </command>
                <!-- route static ipv6 <prefix> <prefix-length> <nexthop> -->
                <command>
                    <expression>2 3 5 [14 15] 6 8 9</expression>
                    <views>config</views>
                </command>
                <!-- route static ipv6 <prefix> <prefix-length> <nexthop> metric <value> -->
                <command>
                    <expression>2 3 5 [14 15] 6 8 9 10 11</expression>
                    <views>config</views>
                </command>
                <!-- no route static ipv6 <prefix> <prefix-length> -->
                <command>
                    <expression>1 2 3 5 [14 15] 6 8</expression>
                    <views>config</views>
                </command>
                <!-- no route static ipv6 <prefix> <prefix-length> <nexthop> -->
                <command>
                    <expression>1 2 3 5 [14 15] 6 8 9</expression>
                    <views>config</views>
                </command>

                <!-- ===== nexthop + interface（IPv4）===== -->
                <!-- route static ipv4 <prefix> <pfxlen> <nexthop> interface <ifname> -->
                <command>
                    <expression>2 3 4 [14 15] 6 7 9 12 13</expression>
                    <views>config</views>
                </command>
                <!-- route static ipv4 <prefix> <pfxlen> <nexthop> interface <ifname> metric <value> -->
                <command>
                    <expression>2 3 4 [14 15] 6 7 9 12 13 10 11</expression>
                    <views>config</views>
                </command>
                <!-- no route static ipv4 <prefix> <pfxlen> <nexthop> interface <ifname> -->
                <command>
                    <expression>1 2 3 4 [14 15] 6 7 9 12 13</expression>
                    <views>config</views>
                </command>

                <!-- ===== interface-only（IPv4）===== -->
                <!-- route static ipv4 <prefix> <pfxlen> interface <ifname> -->
                <command>
                    <expression>2 3 4 [14 15] 6 7 12 13</expression>
                    <views>config</views>
                </command>
                <!-- route static ipv4 <prefix> <pfxlen> interface <ifname> metric <value> -->
                <command>
                    <expression>2 3 4 [14 15] 6 7 12 13 10 11</expression>
                    <views>config</views>
                </command>
                <!-- no route static ipv4 <prefix> <pfxlen> interface <ifname> -->
                <command>
                    <expression>1 2 3 4 [14 15] 6 7 12 13</expression>
                    <views>config</views>
                </command>

                <!-- ===== nexthop + interface（IPv6）===== -->
                <!-- route static ipv6 <prefix> <pfxlen> <nexthop> interface <ifname> -->
                <command>
                    <expression>2 3 5 [14 15] 6 8 9 12 13</expression>
                    <views>config</views>
                </command>
                <!-- route static ipv6 <prefix> <pfxlen> <nexthop> interface <ifname> metric <value> -->
                <command>
                    <expression>2 3 5 [14 15] 6 8 9 12 13 10 11</expression>
                    <views>config</views>
                </command>
                <!-- no route static ipv6 <prefix> <pfxlen> <nexthop> interface <ifname> -->
                <command>
                    <expression>1 2 3 5 [14 15] 6 8 9 12 13</expression>
                    <views>config</views>
                </command>

                <!-- ===== interface-only（IPv6）===== -->
                <!-- route static ipv6 <prefix> <pfxlen> interface <ifname> -->
                <command>
                    <expression>2 3 5 [14 15] 6 8 12 13</expression>
                    <views>config</views>
                </command>
                <!-- route static ipv6 <prefix> <pfxlen> interface <ifname> metric <value> -->
                <command>
                    <expression>2 3 5 [14 15] 6 8 12 13 10 11</expression>
                    <views>config</views>
                </command>
                <!-- no route static ipv6 <prefix> <pfxlen> interface <ifname> -->
                <command>
                    <expression>1 2 3 5 [14 15] 6 8 12 13</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

        <!-- ================================================================
             Group 2: show route 命令
             元素位置：1=show, 2=route, 3=ipv4, 4=ipv6, 5=<destination>,
                       6=proto, 7=static, 8=bgp, 9=ospf, 10=summary,
                       11=connected, 12=isis,
                       13=<prefix-length-v4>, 14=<prefix-length-v6>,
                       15=subscribe
             cfg-id: 1=ipv4, 2=ipv6, 4=dest_filter,
                     5=proto:static, 6=proto:bgp, 7=proto:ospf, 8=summary,
                     9=proto:connected, 11=proto:isis,
                     12=dest_prefix_len_v4, 13=dest_prefix_len_v6,
                     14=subscribe
             ================================================================ -->
        <group group-id="2">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>route</name>
                    <description>Routing table</description>
                </element>
                <element id="3" cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 routes</description>
                </element>
                <element id="4" cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 routes</description>
                </element>
                <element id="5" cfg-id="4" type="parameter">
                    <name>&lt;destination&gt;</name>
                    <type>string</type>
                    <description>Filter by destination address</description>
                </element>
                <element id="6" type="keyword">
                    <name>proto</name>
                    <description>Filter by protocol type</description>
                </element>
                <element id="7" cfg-id="5" type="keyword">
                    <name>static</name>
                    <description>Static routes</description>
                </element>
                <element id="8" cfg-id="6" type="keyword">
                    <name>bgp</name>
                    <description>BGP routes</description>
                </element>
                <element id="9" cfg-id="7" type="keyword">
                    <name>ospf</name>
                    <description>OSPF routes</description>
                </element>
                <element id="10" cfg-id="8" type="keyword">
                    <name>summary</name>
                    <description>Route summary statistics</description>
                </element>
                <element id="11" cfg-id="9" type="keyword">
                    <name>connected</name>
                    <description>Directly connected routes</description>
                </element>
                <element id="12" cfg-id="11" type="keyword">
                    <name>isis</name>
                    <description>ISIS routes</description>
                </element>
                <element id="13" cfg-id="12" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-32)</type>
                    <description>IPv4 destination prefix length (0-32)</description>
                </element>
                <element id="14" cfg-id="13" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-128)</type>
                    <description>IPv6 destination prefix length (0-128)</description>
                </element>
                <element id="15" cfg-id="14" type="keyword">
                    <name>subscribe</name>
                    <description>Route update subscriptions</description>
                </element>
                <element id="16" cfg-id="15" type="keyword">
                    <name>vrf</name>
                    <description>Filter by VRF name</description>
                </element>
                <element id="17" cfg-id="16" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <type>dynamic(4:1,string(1-63))</type>
                    <description>VRF name</description>
                </element>
            </elements>

            <commands>
                <!-- show route { ipv4 | ipv6 } -->
                <command>
                    <expression>1 2 { 3 | 4 } [16 17]</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 <destination> <prefix-length> -->
                <command>
                    <expression>1 2 3 [16 17] 5 13</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 <destination> <prefix-length> -->
                <command>
                    <expression>1 2 4 [16 17] 5 14</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto static -->
                <command>
                    <expression>1 2 3 [16 17] 6 7</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto static -->
                <command>
                    <expression>1 2 4 [16 17] 6 7</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto bgp -->
                <command>
                    <expression>1 2 3 [16 17] 6 8</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto bgp -->
                <command>
                    <expression>1 2 4 [16 17] 6 8</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto ospf -->
                <command>
                    <expression>1 2 3 [16 17] 6 9</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto ospf -->
                <command>
                    <expression>1 2 4 [16 17] 6 9</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto connected -->
                <command>
                    <expression>1 2 3 [16 17] 6 11</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto connected -->
                <command>
                    <expression>1 2 4 [16 17] 6 11</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 proto isis -->
                <command>
                    <expression>1 2 3 [16 17] 6 12</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 proto isis -->
                <command>
                    <expression>1 2 4 [16 17] 6 12</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 summary -->
                <command>
                    <expression>1 2 3 [16 17] 10</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 summary -->
                <command>
                    <expression>1 2 4 [16 17] 10</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv4 subscribe -->
                <command>
                    <expression>1 2 3 [16 17] 15</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 subscribe -->
                <command>
                    <expression>1 2 4 [16 17] 15</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- ================================================================
             Group 3: 批量静态路由命令
             cfg-id: 1=no, 2=static-batch, 3=ipv4, 4=ipv6,
                     5=start_addr, 6=prefix_len(IPv4), 7=prefix_len(IPv6),
                     8=count_value, 9=nexthop, 10=name, 11=metric_value,
                     12=interface, 13=ifname, 14=vrf, 15=vrf-name
             元素顺序：no route static-batch <name> ipv4 ipv6 vrf <vrf-name> <start> <pfx4> <pfx6>
                       <nexthop> interface <ifname> metric <metric> count <count>
             ================================================================ -->
        <group group-id="3">
            <elements>
                <element id="1" cfg-id="1" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element id="2" type="keyword">
                    <name>route</name>
                    <description>Route</description>
                </element>
                <element id="3" cfg-id="2" type="keyword">
                    <name>static-batch</name>
                    <description>Static batch route operation</description>
                </element>
                <element id="4" cfg-id="10" type="parameter">
                    <name>&lt;name&gt;</name>
                    <type>string(1-63)</type>
                    <description>Batch name (used as key)</description>
                </element>
                <element id="5" cfg-id="3" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 batch route</description>
                </element>
                <element id="6" cfg-id="4" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 batch route</description>
                </element>
                <element id="7" cfg-id="5" type="parameter">
                    <name>&lt;start-address&gt;</name>
                    <type>string</type>
                    <description>Starting network address</description>
                </element>
                <element id="8" cfg-id="6" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(1-32)</type>
                    <description>Prefix length (IPv4, 1-32)</description>
                </element>
                <element id="9" cfg-id="7" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(1-128)</type>
                    <description>Prefix length (IPv6, 1-128)</description>
                </element>
                <element id="10" cfg-id="9" type="parameter">
                    <name>&lt;nexthop&gt;</name>
                    <type>string</type>
                    <description>Next-hop address</description>
                </element>
                <element id="11" type="keyword">
                    <name>metric</name>
                    <description>Set metric value</description>
                </element>
                <element id="12" cfg-id="11" type="parameter">
                    <name>&lt;metric-value&gt;</name>
                    <type>uint(0-255)</type>
                    <description>Route metric value (0-255)</description>
                </element>
                <element id="13" cfg-id="12" type="keyword">
                    <name>interface</name>
                    <description>Specify output interface</description>
                </element>
                <element id="14" cfg-id="13" type="parameter">
                    <name>&lt;ifname&gt;</name>
                    <type>dynamic(5:1,string(1-31))</type>
                    <description>Output interface name</description>
                </element>
                <element id="15" type="keyword">
                    <name>count</name>
                    <description>Route count</description>
                </element>
                <element id="16" cfg-id="8" type="parameter">
                    <name>&lt;count&gt;</name>
                    <type>uint(1-100000)</type>
                    <description>Number of routes to generate</description>
                </element>
                <element id="17" cfg-id="14" type="keyword">
                    <name>vrf</name>
                    <description>Route VRF</description>
                </element>
                <element id="18" cfg-id="15" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <type>dynamic(4:1,string(1-63))</type>
                    <description>VRF name</description>
                </element>
            </elements>

            <commands>
                <!-- route static-batch <name> ipv4 [vrf <name>] <start> <pfx4> <nexthop> count <N> -->
                <command>
                    <expression>2 3 4 5 [17 18] 7 8 10 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv4 [vrf <name>] <start> <pfx4> <nexthop> metric <value> count <N> -->
                <command>
                    <expression>2 3 4 5 [17 18] 7 8 10 11 12 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv4 [vrf <name>] <start> <pfx4> <nexthop> interface <ifname> count <N> -->
                <command>
                    <expression>2 3 4 5 [17 18] 7 8 10 13 14 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv4 [vrf <name>] <start> <pfx4> <nexthop> interface <ifname> metric <value> count <N> -->
                <command>
                    <expression>2 3 4 5 [17 18] 7 8 10 13 14 11 12 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv4 [vrf <name>] <start> <pfx4> interface <ifname> count <N> -->
                <command>
                    <expression>2 3 4 5 [17 18] 7 8 13 14 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv4 [vrf <name>] <start> <pfx4> interface <ifname> metric <value> count <N> -->
                <command>
                    <expression>2 3 4 5 [17 18] 7 8 13 14 11 12 15 16</expression>
                    <views>config</views>
                </command>

                <!-- route static-batch <name> ipv6 [vrf <name>] <start> <pfx6> <nexthop> count <N> -->
                <command>
                    <expression>2 3 4 6 [17 18] 7 9 10 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv6 [vrf <name>] <start> <pfx6> <nexthop> metric <value> count <N> -->
                <command>
                    <expression>2 3 4 6 [17 18] 7 9 10 11 12 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv6 [vrf <name>] <start> <pfx6> <nexthop> interface <ifname> count <N> -->
                <command>
                    <expression>2 3 4 6 [17 18] 7 9 10 13 14 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv6 [vrf <name>] <start> <pfx6> <nexthop> interface <ifname> metric <value> count <N> -->
                <command>
                    <expression>2 3 4 6 [17 18] 7 9 10 13 14 11 12 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv6 [vrf <name>] <start> <pfx6> interface <ifname> count <N> -->
                <command>
                    <expression>2 3 4 6 [17 18] 7 9 13 14 15 16</expression>
                    <views>config</views>
                </command>
                <!-- route static-batch <name> ipv6 [vrf <name>] <start> <pfx6> interface <ifname> metric <value> count <N> -->
                <command>
                    <expression>2 3 4 6 [17 18] 7 9 13 14 11 12 15 16</expression>
                    <views>config</views>
                </command>
                <!-- no route static-batch <name> -->
                <command>
                    <expression>1 2 3 4</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

        <!-- ================================================================
             Group 5: show route ipv4/ipv6 static 命令（候选静态路由表）
             cfg-id: 1=ipv4, 2=ipv6
             ================================================================ -->
        <group group-id="5">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>route</name>
                    <description>Route module</description>
                </element>
                <element id="3" cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 static candidate table</description>
                </element>
                <element id="4" cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 static candidate table</description>
                </element>
                <element id="5" type="keyword">
                    <name>static</name>
                    <description>Static route candidate table</description>
                </element>
                <element id="6" cfg-id="3" type="keyword">
                    <name>vrf</name>
                    <description>Filter by VRF name</description>
                </element>
                <element id="7" cfg-id="4" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <type>dynamic(4:1,string(1-63))</type>
                    <description>VRF name</description>
                </element>
            </elements>

            <commands>
                <!-- show route ipv4 static -->
                <command>
                    <expression>1 2 3 [6 7] 5</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 static -->
                <command>
                    <expression>1 2 4 [6 7] 5</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- ================================================================
             Group 4: show route ipv4/ipv6 relay 命令
             cfg-id: 1=ipv4, 2=ipv6, 3=bgp（按 BGP 模块过滤），4=static（按静态路由过滤）
             ================================================================ -->
        <group group-id="4">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>route</name>
                    <description>Route module</description>
                </element>
                <element id="3" cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 relay watch table</description>
                </element>
                <element id="4" cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 relay watch table</description>
                </element>
                <element id="5" type="keyword">
                    <name>relay</name>
                    <description>Nexthop iteration relay watch table</description>
                </element>
                <element id="6" cfg-id="3" type="keyword">
                    <name>bgp</name>
                    <description>Filter by BGP module</description>
                </element>
                <element id="7" cfg-id="4" type="keyword">
                    <name>static</name>
                    <description>Show static route nexthop relay status (candidate table)</description>
                </element>
                <element id="8" cfg-id="5" type="keyword">
                    <name>vrf</name>
                    <description>Filter by VRF name</description>
                </element>
                <element id="9" cfg-id="6" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <type>dynamic(4:1,string(1-63))</type>
                    <description>VRF name</description>
                </element>
            </elements>

            <commands>
                <!-- show route ipv4 relay -->
                <command>
                    <expression>1 2 3 [8 9] 5</expression>
                    <views>global</views>
                </command>
                <!-- show route ipv6 relay -->
                <command>
                    <expression>1 2 4 [8 9] 5</expression>
                    <views>global</views>
