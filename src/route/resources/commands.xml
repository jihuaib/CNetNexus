<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="6">
    <!-- View definitions -->
    <views>
    </views>

    <!-- Command group definitions -->
    <command_groups>
        <!-- Route configuration command group -->
        <group group-id="1">
            <elements>
                <element cfg-id="1" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>Static route configuration</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 route</description>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 route</description>
                </element>
                <element cfg-id="4" type="parameter">
                    <name>&lt;destination&gt;</name>
                    <type>string</type>
                    <description>Destination network address</description>
                </element>
                <element cfg-id="5" type="parameter">
                    <name>&lt;mask&gt;</name>
                    <type>string</type>
                    <description>Network mask (IPv4)</description>
                </element>
                <element cfg-id="6" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-128)</type>
                    <description>Prefix length (IPv6)</description>
                </element>
                <element cfg-id="7" type="parameter">
                    <name>&lt;next-hop&gt;</name>
                    <type>string</type>
                    <description>Next hop address</description>
                </element>
                <element cfg-id="8" type="parameter">
                    <name>&lt;metric&gt;</name>
                    <type>uint(0-255)</type>
                    <description>Route metric</description>
                </element>
            </elements>

            <commands>
                <!-- route ipv4 <destination> <mask> <next-hop> [metric] -->
                <command>
                    <expression>2 3 5 6 8 [ 9 ]</expression>
                    <views>3</views>
                </command>
                <!-- route ipv6 <destination> <prefix-length> <next-hop> [metric] -->
                <command>
                    <expression>2 4 5 7 8 [ 9 ]</expression>
                    <views>3</views>
                </command>
                <!-- no route ipv4 <destination> <mask> [next-hop] -->
                <command>
                    <expression>1 2 3 5 6 [ 8 ]</expression>
                    <views>3</views>
                </command>
                <!-- no route ipv6 <destination> <prefix-length> [next-hop] -->
                <command>
                    <expression>1 2 4 5 7 [ 8 ]</expression>
                    <views>3</views>
                </command>
            </commands>
        </group>

        <!-- Show route command group -->
        <group group-id="2">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>Routing table</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 routes</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 routes</description>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>all</name>
                    <description>All routes (IPv4 and IPv6)</description>
                </element>
                <element cfg-id="4" type="parameter">
                    <name>&lt;destination&gt;</name>
                    <type>string</type>
                    <description>Filter by destination address</description>
                </element>
            </elements>

            <commands>
                <!-- show route ipv4 [destination] -->
                <command>
                    <expression>1 2 3 [ 6 ]</expression>
                    <views>1</views>
                </command>
                <!-- show route ipv6 [destination] -->
                <command>
                    <expression>1 2 4 [ 6 ]</expression>
                    <views>1</views>
                </command>
                <!-- show route all -->
                <command>
                    <expression>1 2 5</expression>
                    <views>1</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
