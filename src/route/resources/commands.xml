<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="6" db="route_db">
    <!-- View definitions -->
    <views>
    </views>

    <!-- Command group definitions -->
    <command_groups>
        <!-- Route configuration command group -->
        <group group-id="1" table="route_ipv4">
            <elements>
                <element cfg-id="1" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>Static route configuration</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 route</description>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 route</description>
                </element>
                <element cfg-id="4" type="parameter" field="destination">
                    <name>&lt;destination&gt;</name>
                    <type>string</type>
                    <description>Destination network address</description>
                </element>
                <element cfg-id="5" type="parameter" field="mask">
                    <name>&lt;mask&gt;</name>
                    <type>string</type>
                    <description>Network mask (IPv4)</description>
                </element>
                <element cfg-id="6" type="parameter" field="prefix_length">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-128)</type>
                    <description>Prefix length (IPv6)</description>
                </element>
                <element cfg-id="7" type="parameter" field="next_hop">
                    <name>&lt;next-hop&gt;</name>
                    <type>string</type>
                    <description>Next hop address</description>
                </element>
                <element cfg-id="8" type="parameter" field="metric">
                    <name>&lt;metric&gt;</name>
                    <type>uint(0-255)</type>
                    <description>Route metric</description>
                </element>
            </elements>

            <commands>
                <!-- route ipv4 <destination> <mask> <next-hop> [metric] -->
                <command>
                    <expression>2 3 5 6 8 [ 9 ]</expression>
                    <views>3</views>
                </command>
                <!-- route ipv6 <destination> <prefix-length> <next-hop> [metric] -->
                <command>
                    <expression>2 4 5 7 8 [ 9 ]</expression>
                    <views>3</views>
                </command>
                <!-- no route ipv4 <destination> <mask> [next-hop] -->
                <command>
                    <expression>1 2 3 5 6 [ 8 ]</expression>
                    <views>3</views>
                </command>
                <!-- no route ipv6 <destination> <prefix-length> [next-hop] -->
                <command>
                    <expression>1 2 4 5 7 [ 8 ]</expression>
                    <views>3</views>
                </command>
            </commands>
        </group>

        <!-- Show route command group -->
        <group group-id="2" table="route_ipv4">
            <elements>
                <element type="keyword" field="action">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>Routing table</description>
                </element>
                <element cfg-id="1" type="keyword" field="family">
                    <name>ipv4</name>
                    <description>IPv4 routes</description>
                </element>
                <element cfg-id="2" type="keyword" field="family">
                    <name>ipv6</name>
                    <description>IPv6 routes</description>
                </element>
                <element cfg-id="3" type="keyword" field="family">
                    <name>all</name>
                    <description>All routes (IPv4 and IPv6)</description>
                </element>
                <element cfg-id="4" type="parameter" field="destination">
                    <name>&lt;destination&gt;</name>
                    <type>string</type>
                    <description>Filter by destination address</description>
                </element>
            </elements>

            <commands>
                <!-- show route ipv4 [destination] -->
                <command>
                    <expression>1 2 3 [ 6 ]</expression>
                    <views>1</views>
                    <show-template>route_show_template</show-template>
                </command>
                <!-- show route ipv6 [destination] -->
                <command>
                    <expression>1 2 4 [ 6 ]</expression>
                    <views>1</views>
                    <show-template>route_show_template</show-template>
                </command>
                <!-- show route all -->
                <command>
                    <expression>1 2 5</expression>
                    <views>1</views>
                    <show-template>route_show_template</show-template>
                </command>
            </commands>
        </group>
    </command_groups>

    <config_templates>
        <!-- Route show 模板（临时 DB） -->
        <template-def template-name="route_show_template" priority="0">
            <template-def template-name="route_show_ipv4_template"/>
            <template-def template-name="route_show_ipv6_template"/>
        </template-def>

        <template template-name="route_show_template" db="route_show_db.route_show_meta">
Route Table:
{% if route_show_meta.has_rows == 0 %}
No routes.
{% endif %}
        </template>

        <template template-name="route_show_ipv4_template" db="route_show_db.route_show_ipv4">
{% if route_show_ipv4.is_first == 1 %}
IPv4 Routes:
Destination Mask NextHop Metric
------------------ ------------------ ------------------ --------
{% endif %}
{route_show_ipv4.destination} {route_show_ipv4.mask} {route_show_ipv4.next_hop} {route_show_ipv4.metric}
        </template>

        <template template-name="route_show_ipv6_template" db="route_show_db.route_show_ipv6">
{% if route_show_ipv6.is_first == 1 %}
IPv6 Routes:
Destination Prefix NextHop Metric
---------------------------------------- ------ ---------------------------------------- --------
{% endif %}
{route_show_ipv6.destination} {route_show_ipv6.prefix_length} {route_show_ipv6.next_hop} {route_show_ipv6.metric}
        </template>
    </config_templates>

    <!-- Database definitions -->
    <dbs>
        <db db-name="route_db">
            <tables>
                <!-- IPv4 routing table -->
                <table table-name="route_ipv4">
                    <fields>
                        <field field-name="destination" type="string"/>
                        <field field-name="mask" type="string"/>
                        <field field-name="next_hop" type="string"/>
                        <field field-name="metric" type="uint(0-255)"/>
                    </fields>
                </table>
                
                <!-- IPv6 routing table -->
                <table table-name="route_ipv6">
                    <fields>
                        <field field-name="destination" type="string"/>
                        <field field-name="prefix_length" type="uint(0-128)"/>
                        <field field-name="next_hop" type="string"/>
                        <field field-name="metric" type="uint(0-255)"/>
                    </fields>
                </table>
            </tables>
        </db>

        <db db-name="route_show_db">
            <tables>
                <table table-name="route_show_meta">
                    <fields>
                        <field field-name="has_rows" type="uint(0-1)"/>
                    </fields>
                </table>
                <table table-name="route_show_ipv4">
                    <fields>
                        <field field-name="destination" type="string(1-63)"/>
                        <field field-name="mask" type="string(1-63)"/>
                        <field field-name="next_hop" type="string(1-63)"/>
                        <field field-name="metric" type="uint(0-255)"/>
                        <field field-name="is_first" type="uint(0-1)"/>
                    </fields>
                </table>
                <table table-name="route_show_ipv6">
                    <fields>
                        <field field-name="destination" type="string(1-63)"/>
                        <field field-name="prefix_length" type="uint(0-128)"/>
                        <field field-name="next_hop" type="string(1-63)"/>
                        <field field-name="metric" type="uint(0-255)"/>
                        <field field-name="is_first" type="uint(0-1)"/>
                    </fields>
                </table>
            </tables>
        </db>
    </dbs>
</configuration>
