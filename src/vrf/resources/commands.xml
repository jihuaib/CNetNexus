<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="4">

    <!-- View definitions -->
    <views>
        <view view-name="vrf">
            <template>&lt;NetNexus(config-vrf-{ctx:5})&gt;</template>
            <view view-name="vrf-af-ipv4">
                <template>&lt;NetNexus(config-vrf-{ctx:5}-af-ipv4)&gt;</template>
            </view>
            <view view-name="vrf-af-ipv6">
                <template>&lt;NetNexus(config-vrf-{ctx:5}-af-ipv6)&gt;</template>
            </view>
        </view>
    </views>

    <show-this>
        <view name="vrf"/>
        <view name="vrf-af-ipv4"/>
        <view name="vrf-af-ipv6"/>
    </show-this>

    <command_groups>

        <!-- group 1: vrf <vrf-name> / no vrf <vrf-name> -->
        <group group-id="1">
            <elements>
                <element id="1" type="keyword">
                    <name>vrf</name>
                    <description>Configure VRF instance</description>
                </element>
                <element id="2" cfg-id="1" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <type>dynamic(string(1-63))</type>
                    <description>VRF name</description>
                </element>
                <element id="3" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>config</views>
                    <to-view>vrf</to-view>
                    <context-out>
                        <entry ctx-id="5" from-param="1"/>
                    </context-out>
                </command>
                <command>
                    <expression>3 1 2</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

        <!-- group 2: show vrf | show vrf name <vrf-name> -->
        <group group-id="2">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>vrf</name>
                    <description>VRF table</description>
                </element>
                <element id="3" type="keyword">
                    <name>name</name>
                    <description>Display detail by VRF name</description>
                </element>
                <element id="4" cfg-id="3" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <type>dynamic(string(1-63))</type>
                    <description>VRF name</description>
                </element>
                <element id="5" cfg-id="4" type="keyword">
                    <name>subscribe</name>
                    <description>VRF event subscriptions</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 2 3 4</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 2 5</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- group 3: af ipv4 / af ipv6 / no af ... -->
        <group group-id="3">
            <elements>
                <element id="1" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element id="2" type="keyword">
                    <name>af</name>
                    <description>Enter address family configuration</description>
                </element>
                <element id="3" cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 address family</description>
                </element>
                <element id="4" cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 address family</description>
                </element>
            </elements>

            <commands>
                <!-- af ipv4 -->
                <command>
                    <expression>2 3</expression>
                    <views>vrf</views>
                    <to-view>vrf-af-ipv4</to-view>
                    <context-out>
                        <entry ctx-id="9" value="1"/>
                    </context-out>
                </command>
                <!-- af ipv6 -->
                <command>
                    <expression>2 4</expression>
                    <views>vrf</views>
                    <to-view>vrf-af-ipv6</to-view>
                    <context-out>
                        <entry ctx-id="9" value="2"/>
                    </context-out>
                </command>
                <!-- no af { ipv4 | ipv6 } -->
                <command>
                    <expression>1 2 { 3 | 4 }</expression>
                    <views>vrf</views>
                </command>
            </commands>
        </group>

        <!-- group 4: route-distinguisher <rd> / no route-distinguisher -->
        <group group-id="4">
            <elements>
                <element id="1" type="keyword">
                    <name>route-distinguisher</name>
                    <description>VRF Route Distinguisher</description>
                </element>
                <element id="2" cfg-id="1" type="parameter">
                    <name>&lt;rd&gt;</name>
                    <type>string(3-32)</type>
                    <description>RD format ASN:NN or IP:NN</description>
                </element>
                <element id="3" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
                <command>
                    <expression>3 1</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
            </commands>
        </group>

        <!-- group 6: show vrf os -->
        <group group-id="6">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>vrf</name>
                    <description>VRF</description>
                </element>
                <element id="3" type="keyword">
                    <name>os</name>
                    <description>Show OS-side L3VRF devices via netlink</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- group 5: vpn-target <rt> [import|export|both] / no ... -->
        <group group-id="5">
            <elements>
                <element id="1" type="keyword">
                    <name>vpn-target</name>
                    <description>VRF Route Target</description>
                </element>
                <element id="2" cfg-id="1" type="parameter">
                    <name>&lt;rt&gt;</name>
                    <type>string(3-32)</type>
                    <description>RT format ASN:NN or IP:NN</description>
                </element>
                <element id="3" cfg-id="2" type="keyword">
                    <name>import</name>
                    <description>Import direction</description>
                </element>
                <element id="4" cfg-id="2" type="keyword">
                    <name>export</name>
                    <description>Export direction</description>
                </element>
                <element id="5" cfg-id="2" type="keyword">
                    <name>both</name>
                    <description>Both import and export</description>
                </element>
                <element id="6" type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element id="7" cfg-id="3" type="keyword">
                    <name>evpn</name>
                    <description>EVPN route-target type</description>
                </element>
            </elements>

            <commands>
                <!-- vpn-target <rt> [import|export|both] [evpn] -->
                <command>
                    <expression>1 2</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
                <command>
                    <expression>1 2 { 3 | 4 | 5 }</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
                <command>
                    <expression>1 2 7</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
                <command>
                    <expression>1 2 { 3 | 4 | 5 } 7</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
                <!-- no vpn-target <rt> [import|export|both] [evpn] -->
                <command>
                    <expression>6 1 2</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
                <command>
                    <expression>6 1 2 { 3 | 4 | 5 }</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
                <command>
                    <expression>6 1 2 7</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
                <command>
                    <expression>6 1 2 { 3 | 4 | 5 } 7</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
            </commands>
        </group>

        <!-- group 7: apply-label per-vrf|per-route / no apply-label -->
        <group group-id="7">
            <elements>
                <element id="1" type="keyword">
                    <name>apply-label</name>
                    <description>VPN label allocation mode for export to vpnv4</description>
                </element>
                <element id="2" cfg-id="3" type="keyword">
                    <name>per-vrf</name>
                    <description>One aggregate label per VRF (default)</description>
                </element>
                <element id="3" cfg-id="3" type="keyword">
                    <name>per-route</name>
                    <description>One label per route</description>
                </element>
                <element id="4" type="keyword">
                    <name>no</name>
                    <description>Restore default (per-vrf)</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 { 2 | 3 }</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
                <command>
                    <expression>4 1</expression>
                    <views>vrf-af-ipv4,vrf-af-ipv6</views>
                </command>
            </commands>
        </group>

    </command_groups>
</configuration>
