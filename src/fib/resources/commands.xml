<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="11">
    <views>
    </views>
    <command_groups>
        <!-- Group 1: show fib os {ipv4|ipv6} [<prefix> <mask>], show fib mpls [os] [<label>] -->
        <group group-id="1">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>fib</name>
                    <description>Forwarding information base</description>
                </element>
                <element id="3" cfg-id="1" type="keyword">
                    <name>ipv4</name>
                    <description>IPv4 forwarding table</description>
                </element>
                <element id="4" cfg-id="2" type="keyword">
                    <name>ipv6</name>
                    <description>IPv6 forwarding table</description>
                </element>
                <element id="5" cfg-id="3" type="keyword">
                    <name>os</name>
                    <description>Linux kernel routing table</description>
                </element>
                <element id="6" cfg-id="4" type="parameter">
                    <name>&lt;prefix&gt;</name>
                    <type>string</type>
                    <description>Filter by FIB prefix</description>
                </element>
                <element id="7" cfg-id="5" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-32)</type>
                    <description>IPv4 prefix length (0-32)</description>
                </element>
                <element id="8" cfg-id="6" type="parameter">
                    <name>&lt;prefix-length&gt;</name>
                    <type>uint(0-128)</type>
                    <description>IPv6 prefix length (0-128)</description>
                </element>
                <element id="9" cfg-id="7" type="keyword">
                    <name>mpls</name>
                    <description>MPLS incoming label map</description>
                </element>
                <element id="10" cfg-id="8" type="parameter">
                    <name>&lt;label&gt;</name>
                    <type>uint(0-1048575)</type>
                    <description>MPLS incoming label</description>
                </element>
                <element id="11" cfg-id="9" type="keyword">
                    <name>vrf</name>
                    <description>Filter by VRF name</description>
                </element>
                <element id="12" cfg-id="10" type="parameter">
                    <name>&lt;vrf-name&gt;</name>
                    <type>dynamic(4:1,string(1-63))</type>
                    <description>VRF name</description>
                </element>
                <element id="13" cfg-id="11" type="keyword">
                    <name>nexthop</name>
                    <description>FIB nexthop objects</description>
                </element>
                <element id="14" cfg-id="12" type="keyword">
                    <name>id</name>
                    <description>Filter by nexthop id</description>
                </element>
                <element id="15" cfg-id="13" type="parameter">
                    <name>&lt;nexthop-id&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>Nexthop object id</description>
                </element>
            </elements>
            <commands>
                <!-- show fib ipv4 -->
                <command>
                    <expression>1 2 3 [11 12]</expression>
                    <views>global</views>
                </command>
                <!-- show fib ipv6 -->
                <command>
                    <expression>1 2 4 [11 12]</expression>
                    <views>global</views>
                </command>
                <!-- show fib ipv4 <prefix> <prefix-length> -->
                <command>
                    <expression>1 2 3 [11 12] 6 7</expression>
                    <views>global</views>
                </command>
                <!-- show fib ipv6 <prefix> <prefix-length> -->
                <command>
                    <expression>1 2 4 [11 12] 6 8</expression>
                    <views>global</views>
                </command>
                <!-- show fib os ipv4 -->
                <command>
                    <expression>1 2 5 3 [11 12]</expression>
                    <views>global</views>
                </command>
                <!-- show fib os ipv6 -->
                <command>
                    <expression>1 2 5 4 [11 12]</expression>
                    <views>global</views>
                </command>
                <!-- show fib os ipv4 <prefix> <prefix-length> -->
                <command>
                    <expression>1 2 5 3 [11 12] 6 7</expression>
                    <views>global</views>
                </command>
                <!-- show fib os ipv6 <prefix> <prefix-length> -->
                <command>
                    <expression>1 2 5 4 [11 12] 6 8</expression>
                    <views>global</views>
                </command>
                <!-- show fib mpls -->
                <command>
                    <expression>1 2 9 [11 12]</expression>
                    <views>global</views>
                </command>
                <!-- show fib mpls os -->
                <command>
                    <expression>1 2 9 5 [11 12]</expression>
                    <views>global</views>
                </command>
                <!-- show fib mpls os [vrf <name>] <label> -->
                <command>
                    <expression>1 2 9 5 [11 12] 10</expression>
                    <views>global</views>
                </command>
                <!-- show fib nexthop {ipv4|ipv6} [vrf <name>] [id <id>]（afi 必填，vrf 在 id 之前） -->
                <command>
                    <expression>1 2 13 3 [11 12] [14 15]</expression>
                    <views>global</views>
                </command>
                <command>
                    <expression>1 2 13 4 [11 12] [14 15]</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
