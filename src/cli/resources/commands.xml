<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="3">
    <!-- Command group definitions -->
    <command_groups>
        <!-- show cli command-info -->
        <group group-id="1">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>command-info</name>
                    <description>Command info</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show cli history -->
        <group group-id="2">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>history</name>
                    <description>Command history</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show current-configuration -->
        <group group-id="3">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>current-configuration</name>
                    <description>Display current configuration</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- exit -->
        <group group-id="4">
            <elements>
                <element id="1" type="keyword">
                    <name>exit</name>
                    <description>Exit current mode</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- config -->
        <group group-id="5">
            <elements>
                <element id="1" type="keyword">
                    <name>config</name>
                    <description>Enter configuration mode</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>user</views>
                </command>
            </commands>
        </group>

        <!-- end -->
        <group group-id="6">
            <elements>
                <element id="1" type="keyword">
                    <name>end</name>
                    <description>Return to user view</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show cli context -->
        <group group-id="8">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>context</name>
                    <description>Current view context variables</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- terminal length 0 -->
        <group group-id="9">
            <elements>
                <element id="1" type="keyword">
                    <name>no</name>
                    <description>Restore default behavior</description>
                </element>
                <element id="2" type="keyword">
                    <name>terminal</name>
                    <description>Terminal session options</description>
                </element>
                <element id="3" type="keyword">
                    <name>length</name>
                    <description>Set terminal output length</description>
                </element>
                <element id="4" type="keyword">
                    <name>0</name>
                    <description>Disable paging for current session</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>2 3 4</expression>
                    <views>user</views>
                </command>
                <command>
                    <expression>1 2 3 4</expression>
                    <views>user</views>
                </command>
            </commands>
        </group>

        <!-- show this -->
        <group group-id="10">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>this</name>
                    <description>Display current view configuration</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- bash -->
        <group group-id="7">
            <elements>
                <element id="1" type="keyword">
                    <name>bash</name>
                    <description>Enter bash shell</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>user</views>
                </command>
            </commands>
        </group>

        <!-- show cli client -->
        <group group-id="11">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>client</name>
                    <description>Connected CLI clients</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
