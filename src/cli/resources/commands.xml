<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="3">
    <!-- Command group definitions -->
    <command_groups>
        <!-- show cli command-info -->
        <group group-id="1">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>command-info</name>
                    <description>Command info</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show cli history -->
        <group group-id="2">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>history</name>
                    <description>Command history</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show current-configuration -->
        <group group-id="3">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>current-configuration</name>
                    <description>Display current configuration</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- exit -->
        <group group-id="4">
            <elements>
                <element id="1" type="keyword">
                    <name>exit</name>
                    <description>Exit current mode</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- config -->
        <group group-id="5">
            <elements>
                <element id="1" type="keyword">
                    <name>config</name>
                    <description>Enter configuration mode</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>user</views>
                </command>
            </commands>
        </group>

        <!-- end -->
        <group group-id="6">
            <elements>
                <element id="1" type="keyword">
                    <name>end</name>
                    <description>Return to user view</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show cli context -->
        <group group-id="8">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>context</name>
                    <description>Current view context variables</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show this -->
        <group group-id="10">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>this</name>
                    <description>Display current view configuration</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show cli client -->
        <group group-id="11">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>client</name>
                    <description>Connected CLI clients</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- show configuration difference current-configuration <snapshot-name> -->
        <group group-id="12">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>configuration</name>
                    <description>Configuration information</description>
                </element>
                <element id="3" type="keyword">
                    <name>difference</name>
                    <description>Compare configurations</description>
                </element>
                <element id="4" type="keyword">
                    <name>current-configuration</name>
                    <description>Use current configuration as baseline</description>
                </element>
                <element id="5" cfg-id="1" type="parameter">
                    <name>&lt;snapshot-name&gt;</name>
                    <description>Saved snapshot name, with optional .cfg suffix</description>
                    <type>string(1-67)</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3 4 5</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- 层级配置回滚；差异预览统一使用 group 12 的 difference 命令 -->
        <group group-id="13">
            <elements>
                <element id="1" cfg-id="1" type="keyword">
                    <name>rollback</name>
                    <description>Apply a preflighted configuration rollback</description>
                </element>
                <element id="2" type="keyword">
                    <name>configuration</name>
                    <description>Configuration snapshot</description>
                </element>
                <element id="3" cfg-id="2" type="parameter">
                    <name>&lt;snapshot-name&gt;</name>
                    <description>Saved snapshot name, with optional .cfg suffix</description>
                    <type>string(1-67)</type>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
