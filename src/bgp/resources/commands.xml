<?xml version="1.0" encoding="UTF-8"?>
<configuration module-id="5">
    <!-- View definitions -->
    <views>
        <view view-name="bgp">
            <template>&lt;NetNexus(config-bgp)&gt;</template>
            <view view-name="bgp-af-ipv4-uni">
                <template>&lt;NetNexus(config-bgp-af-ipv4-uni)&gt;</template>
            </view>
            <view view-name="bgp-af-ipv6-uni">
                <template>&lt;NetNexus(config-bgp-af-ipv6-uni)&gt;</template>
            </view>
        </view>
    </views>

    <!-- Command group definitions -->
    <command_groups>
        <!-- BGP 协议配置命令（bgp <as-number> / no bgp [as-number]） -->
        <group group-id="1">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>bgp</name>
                    <description>BGP protocol</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;as-number&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>BGP as-number</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>2 3</expression>
                    <views>config</views>
                    <to-view>bgp</to-view>
                </command>
                <command>
                    <expression>1 2</expression>
                    <views>config</views>
                </command>
            </commands>
        </group>

        <!-- neighbor <ip> as <as-num> / no neighbor <ip> -->
        <group group-id="2">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>neighbor</name>
                    <description>BGP neighbor configuration</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;ip-address&gt;</name>
                    <type>ip</type>
                    <description>Neighbor IP address</description>
                </element>
                <element type="keyword">
                    <name>as</name>
                    <description>Remote AS number</description>
                </element>
                <element cfg-id="2" type="parameter">
                    <name>&lt;as-number&gt;</name>
                    <type>uint(1-4294967295)</type>
                    <description>Remote AS number</description>
                </element>
            </elements>

            <commands>
                <!-- neighbor <ip> as <as-num> -->
                <command>
                    <expression>2 3 4 5</expression>
                    <views>bgp</views>
                </command>
                <!-- no neighbor <ip> -->
                <command>
                    <expression>1 2 3</expression>
                    <views>bgp</views>
                </command>
            </commands>
        </group>

        <!-- af ipv4-unicast / no af ipv4-unicast -->
        <group group-id="3">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>af</name>
                    <description>Enter address family configuration</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>ipv4-unicast</name>
                    <description>IPv4 unicast address family</description>
                </element>
                 <element cfg-id="2" type="keyword">
                    <name>ipv6-unicast</name>
                    <description>IPv6 unicast address family</description>
                </element>           
            </elements>

            <commands>
                <!-- af ipv4-unicast -->
                <command>
                    <expression>2 3</expression>
                    <views>bgp</views>
                    <to-view>bgp-af-ipv4-uni</to-view>
                    <context-out>
                        <entry ctx-id="2" value="1"/>
                        <entry ctx-id="3" value="1"/>
                    </context-out>
                </command>
                <command>
                    <expression>2 4</expression>
                    <views>bgp</views>
                    <to-view>bgp-af-ipv6-uni</to-view>
                    <context-out>
                        <entry ctx-id="2" value="2"/>
                        <entry ctx-id="3" value="1"/>
                    </context-out>
                </command>
                <!-- no af ipv4-unicast -->
                <command>
                    <expression>1  2  { 3 | 4 }</expression>
                    <views>bgp</views>
                </command>
            </commands>
        </group>

        <!-- neighbor <ip> enable / no neighbor <ip> (in address-family view) -->
        <group group-id="4">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>neighbor</name>
                    <description>BGP neighbor</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;ip-address&gt;</name>
                    <type>ip</type>
                    <description>Neighbor IP address</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>enable</name>
                    <description>Enable neighbor for this address family</description>
                </element>
            </elements>

            <commands>
                <!-- neighbor <ip> enable -->
                <command>
                    <expression>2 3 4</expression>
                    <views>bgp-af-ipv4-uni,bgp-af-ipv6-uni</views>
                </command>
                <!-- no neighbor <ip> -->
                <command>
                    <expression>1 2 3</expression>
                    <views>bgp-af-ipv4-uni,bgp-af-ipv6-uni</views>
                </command>
            </commands>
        </group>
        <!-- router-id <ip-address> / no router-id (在 BGP 视图下) -->
        <group group-id="5">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>router-id</name>
                    <description>BGP Router ID</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;ip-address&gt;</name>
                    <type>ip</type>
                    <description>Router ID (IPv4 address)</description>
                </element>
            </elements>

            <commands>
                <!-- router-id <ip-address> -->
                <command>
                    <expression>2 3</expression>
                    <views>bgp</views>
                </command>
                <!-- no router-id -->
                <command>
                    <expression>1 2</expression>
                    <views>bgp</views>
                </command>
            </commands>
        </group>
        <!-- timer connect-retry <seconds> / no timer connect-retry (BGP 视图) -->
        <group group-id="6">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>timer</name>
                    <description>BGP timer configuration</description>
                </element>
                <element type="keyword">
                    <name>connect-retry</name>
                    <description>Connect-retry timer</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;seconds&gt;</name>
                    <type>uint(1-65535)</type>
                    <description>Reconnect interval in seconds after active connection failure</description>
                </element>
            </elements>

            <commands>
                <!-- timer connect-retry <seconds> -->
                <command>
                    <expression>2 3 4</expression>
                    <views>bgp</views>
                </command>
                <!-- no timer connect-retry -->
                <command>
                    <expression>1 2 3</expression>
                    <views>bgp</views>
                </command>
            </commands>
        </group>

        <!-- timer keepalive <keepalive-time> hold <hold-time> / no timer keepalive (BGP 视图) -->
        <group group-id="7">
            <elements>
                <element type="keyword">
                    <name>timer</name>
                    <description>BGP timer configuration</description>
                </element>
                <element type="keyword">
                    <name>keepalive</name>
                    <description>Keepalive interval</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;keepalive-time&gt;</name>
                    <type>uint(1-65535)</type>
                    <description>Keepalive time in seconds</description>
                </element>
                <element type="keyword">
                    <name>hold</name>
                    <description>Hold time</description>
                </element>
                <element cfg-id="2" type="parameter">
                    <name>&lt;hold-time&gt;</name>
                    <type>uint(1-65535)</type>
                    <description>Hold time in seconds (must be greater than keepalive)</description>
                </element>
            </elements>

            <commands>
                <!-- timer keepalive <n> hold <n> -->
                <command>
                    <expression>1 2 3 4 5</expression>
                    <views>bgp</views>
                </command>
            </commands>
        </group>
        <!-- neighbor <ip> open-capability as4|route-refresh / no neighbor <ip> open-capability ... -->
        <group group-id="8">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>neighbor</name>
                    <description>BGP neighbor configuration</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;ip-address&gt;</name>
                    <type>ip</type>
                    <description>Neighbor IP address</description>
                </element>
                <element type="keyword">
                    <name>open-capability</name>
                    <description>BGP OPEN capability negotiation</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>as4</name>
                    <description>4-byte AS number capability (RFC 6793)</description>
                </element>
                <element cfg-id="3" type="keyword">
                    <name>route-refresh</name>
                    <description>Route Refresh capability (RFC 2918)</description>
                </element>
            </elements>

            <commands>
                <!-- neighbor <ip> open-capability as4 -->
                <command>
                    <expression>2 3 4 5</expression>
                    <views>bgp</views>
                </command>
                <!-- neighbor <ip> open-capability route-refresh -->
                <command>
                    <expression>2 3 4 6</expression>
                    <views>bgp</views>
                </command>
                <!-- no neighbor <ip> open-capability as4 -->
                <command>
                    <expression>1 2 3 4 5</expression>
                    <views>bgp</views>
                </command>
                <!-- no neighbor <ip> open-capability route-refresh -->
                <command>
                    <expression>1 2 3 4 6</expression>
                    <views>bgp</views>
                </command>
            </commands>
        </group>
        <!-- neighbor <ip> source-interface <if-name> / no neighbor <ip> source-interface -->
        <group group-id="12">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>neighbor</name>
                    <description>BGP neighbor configuration</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;ip-address&gt;</name>
                    <type>ip</type>
                    <description>Neighbor IP address</description>
                </element>
                <element type="keyword">
                    <name>source-interface</name>
                    <description>Bind outbound source address from interface</description>
                </element>
                <element cfg-id="2" type="parameter">
                    <name>&lt;if-name&gt;</name>
                    <type>dynamic(4:1,string(1-31))</type>
                    <description>Source interface name (dynamic candidates from IF module)</description>
                </element>
            </elements>

            <commands>
                <!-- neighbor <ip> source-interface <if-name> -->
                <command>
                    <expression>2 3 4 5</expression>
                    <views>bgp</views>
                </command>
                <!-- no neighbor <ip> source-interface -->
                <command>
                    <expression>1 2 3 4</expression>
                    <views>bgp</views>
                </command>
            </commands>
        </group>
        <!-- neighbor <ip> ebgp-multihop <ttl> / no neighbor <ip> ebgp-multihop -->
        <group group-id="13">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>neighbor</name>
                    <description>BGP neighbor configuration</description>
                </element>
                <element cfg-id="1" type="parameter">
                    <name>&lt;ip-address&gt;</name>
                    <type>ip</type>
                    <description>Neighbor IP address</description>
                </element>
                <element type="keyword">
                    <name>ebgp-multihop</name>
                    <description>Allow eBGP neighbor not directly connected</description>
                </element>
                <element cfg-id="2" type="parameter">
                    <name>&lt;ttl&gt;</name>
                    <type>uint(1-255)</type>
                    <description>TTL hops for eBGP multihop</description>
                </element>
            </elements>

            <commands>
                <!-- neighbor <ip> ebgp-multihop <ttl> -->
                <command>
                    <expression>2 3 4 5</expression>
                    <views>bgp</views>
                </command>
                <!-- no neighbor <ip> ebgp-multihop -->
                <command>
                    <expression>1 2 3 4</expression>
                    <views>bgp</views>
                </command>
            </commands>
        </group>
        <!-- show bgp neighbor af ipv4-unicast|ipv6-unicast [<ip-address>] -->
        <group group-id="9">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>bgp</name>
                    <description>BGP protocol</description>
                </element>
                <element type="keyword">
                    <name>neighbor</name>
                    <description>BGP neighbor</description>
                </element>
                <element type="keyword">
                    <name>af</name>
                    <description>Address-family selector</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>ipv4-unicast</name>
                    <description>IPv4 unicast address family</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv6-unicast</name>
                    <description>IPv6 unicast address family</description>
                </element>
                <element cfg-id="3" type="parameter">
                    <name>&lt;ip-address&gt;</name>
                    <type>ip</type>
                    <description>Neighbor IP address</description>
                </element>
            </elements>

            <commands>
                <!-- show bgp neighbor af ipv4-unicast（显示所有邻居摘要） -->
                <command>
                    <expression>1 2 3 4 5</expression>
                    <views>global</views>
                </command>
                <!-- show bgp neighbor af ipv6-unicast（显示所有邻居摘要） -->
                <command>
                    <expression>1 2 3 4 6</expression>
                    <views>global</views>
                </command>
                <!-- show bgp neighbor af ipv4-unicast <ip>（显示指定邻居详情） -->
                <command>
                    <expression>1 2 3 4 5 7</expression>
                    <views>global</views>
                </command>
                <!-- show bgp neighbor af ipv6-unicast <ip>（显示指定邻居详情） -->
                <command>
                    <expression>1 2 3 4 6 7</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>

        <!-- import-route static / no import-route static（地址族视图） -->
        <!-- cfg-id: 1=static -->
        <group group-id="11">
            <elements>
                <element type="keyword">
                    <name>no</name>
                    <description>Delete</description>
                </element>
                <element type="keyword">
                    <name>import-route</name>
                    <description>Import external routes</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>static</name>
                    <description>Import static routes</description>
                </element>
            </elements>

            <commands>
                <!-- import-route static -->
                <command>
                    <expression>2 3</expression>
                    <views>bgp-af-ipv4-uni,bgp-af-ipv6-uni</views>
                </command>
                <!-- no import-route static -->
                <command>
                    <expression>1 2 3</expression>
                    <views>bgp-af-ipv4-uni,bgp-af-ipv6-uni</views>
                </command>
            </commands>
        </group>

        <!-- show bgp route af ipv4-unicast|ipv6-unicast [<ip> <masklen>] -->
        <group group-id="10">
            <elements>
                <element type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element type="keyword">
                    <name>bgp</name>
                    <description>BGP protocol</description>
                </element>
                <element type="keyword">
                    <name>route</name>
                    <description>BGP routes</description>
                </element>
                <element type="keyword">
                    <name>af</name>
                    <description>Address-family selector</description>
                </element>
                <element cfg-id="1" type="keyword">
                    <name>ipv4-unicast</name>
                    <description>Show IPv4 unicast routes</description>
                </element>
                <element cfg-id="2" type="keyword">
                    <name>ipv6-unicast</name>
                    <description>Show IPv6 unicast routes</description>
                </element>
                <element cfg-id="3" type="parameter">
                    <name>&lt;ip-address&gt;</name>
                    <type>ip</type>
                    <description>Network address to query</description>
                </element>
                <element cfg-id="4" type="parameter">
                    <name>&lt;masklen&gt;</name>
                    <type>uint(0-128)</type>
                    <description>Prefix length (0-128)</description>
                </element>
            </elements>

            <commands>
                <!-- show bgp route af ipv4-unicast（路由表） -->
                <command>
                    <expression>1 2 3 4 5</expression>
                    <views>global</views>
                </command>
                <!-- show bgp route af ipv6-unicast（路由表） -->
                <command>
                    <expression>1 2 3 4 6</expression>
                    <views>global</views>
                </command>
                <!-- show bgp route af ipv4-unicast <ip> <masklen>（路由详情） -->
                <command>
                    <expression>1 2 3 4 5 7 8</expression>
                    <views>global</views>
                </command>
                <!-- show bgp route af ipv6-unicast <ip> <masklen>（路由详情） -->
                <command>
                    <expression>1 2 3 4 6 7 8</expression>
                    <views>global</views>
                </command>
            </commands>
        </group>
    </command_groups>
</configuration>
